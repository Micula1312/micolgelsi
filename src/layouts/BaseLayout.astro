---
import '../styles/global.css';
import '../styles/year-plane.css';
import '../styles/grid.css';
import '../styles/hacker.css';
import '../styles/glyph-hover.css';
import '../styles/outputs.css';
import '../styles/dashboard.css';
import '../styles/scrollbars.css';
const { title = 'Micol Gelsi' } = Astro.props;
const base = import.meta.env.BASE_URL;
const baseNoSlash = base.replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(baseNoSlash, '').replace(/\/$/, '') || '/';
const fixedShell = ['/', '/play-with-me'].includes(pathname);
const withBase = (path = '') => `${base}${String(path).replace(/^\//, '')}`;
---
<!doctype html>
<html lang="en" data-style="rgb" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Micol Gelsi — artist and researcher" />
    <title>{title}</title>
  </head>
  <body data-fixed-shell={fixedShell ? 'true' : undefined}>
    <div class="shell">
      <header class="site-header">
        <div class="identity">
          <a class="site-name" href={base}>MICOL GELSI</a>
          <p class="site-bio">
            Artist and researcher working across performative and multimedia arts.<br />
            Her practice moves between physical and virtual spaces.<br />
            She works with living archives, bodies, territories and digital systems.<br />
            Memory, liminality and power recur as fields of investigation.<br />
            She works with ASAP and BLIVET and is a member of Sound Studies Forum.
          </p>
        </div>
        <nav class="site-nav" aria-label="Main navigation">
          <a href={`${base}#projects`} aria-current={pathname === '/' ? 'page' : undefined}>PROJECTS</a>
          <a href={withBase('cv/')}>CV</a>
          <a href={withBase('play-with-me/')} aria-current={pathname === '/play-with-me' ? 'page' : undefined}>PLAY WITH ME</a>
        </nav>
      </header>
      <main class="page"><slot /></main>
    </div>

    <div class="system-controls" aria-label="Display settings">
      <div class="system-control">
        <span>Mode</span>
        <button type="button" data-theme-toggle aria-label="Switch light or dark mode">Dark</button>
      </div>
    </div>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.dataset.style = 'rgb';
        const themeButton = document.querySelector('[data-theme-toggle]');
        if (!themeButton) return;
        const updateLabel = () => {
          themeButton.textContent = root.dataset.theme === 'dark' ? 'Dark' : 'Light';
          themeButton.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
        };
        themeButton.addEventListener('click', () => {
          root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          updateLabel();
        });
        updateLabel();
      })();
    </script>
    <script is:inline src={withBase('base-path.js')}></script>
    <script is:inline src={withBase('research-layout.js')}></script>
    <script is:inline src={withBase('home-loader.js')}></script>
    <script is:inline src={withBase('play-save.js')}></script>
  </body>
</html>
