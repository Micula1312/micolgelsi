---
import '../styles/global.css';
import '../styles/year-plane.css';
import '../styles/grid.css';
import '../styles/hacker.css';
import '../styles/glyph-hover.css';
import '../styles/outputs.css';
import '../styles/dashboard.css';
import '../styles/scrollbars.css';
import '../styles/header-clean.css';
import '../styles/compat.css';
import '../styles/project-panels.css';
const { title = 'Micol Gelsi' } = Astro.props;
const base = import.meta.env.BASE_URL;
const baseNoSlash = base.replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(baseNoSlash, '').replace(/\/$/, '') || '/';
const isHome = pathname === '/';
const fixedShell = ['/', '/play-with-me'].includes(pathname);
const projectDetail = pathname.startsWith('/projects/') || pathname.startsWith('/exhibitions/');
const withBase = (path = '') => `${base}${String(path).replace(/^\//, '')}`;
const bioLines = [
  'Multimedia artist and researcher working across public and digital spaces.',
  'Her practice brings found and reclaimed materials into dialogue with low-tech tools and digital technologies.',
  'Through living archives, site-specific interventions and participatory methodologies, she explores collective memory, inclusion and access to digital culture.',
  'More-than-human relations, ecological systems and liminal territories recur as fields of investigation.',
  'She works with ASAP and BLIVET and is a member of Sound Studies Forum.'
];
---
<!doctype html>
<html lang="en" data-style="rgb" data-theme="dark" data-copy-style="pink">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Micol Gelsi — artist and researcher" />
    <meta name="theme-color" content="#080808" />
    <title>{title}</title>
  </head>
  <body data-fixed-shell={fixedShell ? 'true' : undefined} data-project-detail={projectDetail ? 'true' : undefined}>
    {isHome && <section class="entry-gate" data-entry-gate data-entry-lines={JSON.stringify([
      'Per fare questo stupido portfolio',
      'ho consumato tutti i crediti di ChatGPT Plus.',
      'Ho cambiato idea circa quarantasette volte.',
      'Tocca ancora la stella. Ormai ci sei.'
    ])} aria-label="Portfolio entrance">
      <p class="entry-counter" data-entry-counter>01 / 04</p>
      <p class="entry-line" data-entry-line>Per fare questo stupido portfolio</p>
      <button class="entry-star" type="button" data-entry-star aria-label="Continue">★</button>
      <p class="entry-instruction" data-entry-instruction>TOUCH THE STAR</p>
      <button class="entry-skip" type="button" data-entry-skip>SKIP THIS NONSENSE ↗</button>
    </section>}
    <div class="shell">
      <header class="site-header">
        <div class="identity">
          <button class="site-name" type="button" data-bio-trigger aria-expanded="false" aria-controls="bio-popup">MICOL GELSI</button>
          <aside class="bio-popup" id="bio-popup" data-bio-popup aria-hidden="true">
            <div class="bio-popup-copy" aria-live="polite">
              {bioLines.map((line, index) => <p class="site-bio bio-popup-line" data-bio-line={index} hidden={index > 0}>{line}</p>)}
            </div>
            <div class="bio-popup-footer">
              <button class="bio-more" type="button" data-bio-more>BLA +</button>
              <span class="bio-xoxox" data-bio-xoxox hidden>XOXOX</span>
              <a class="bio-contact" data-bio-contact href={withBase('play-with-me/')} hidden>KEEP IN TOUCH ↗</a>
              <button class="bio-close" type="button" data-bio-close aria-label="Close biography">ENOUGH FOR NOW ×</button>
            </div>
          </aside>
        </div>
        <nav class="site-nav" aria-label="Main navigation">
          <a href={`${base}#projects`} aria-current={pathname === '/' ? 'page' : undefined}>PROJECTS</a>
          <a href={withBase('cv/micol-gelsi-CV.pdf')} target="_blank" rel="noopener">CV</a>
          <a href={withBase('play-with-me/')} aria-current={pathname === '/play-with-me' ? 'page' : undefined}>PLAY WITH ME</a>
        </nav>
      </header>
      <main class="page"><slot /></main>
    </div>

    <div class="system-controls" aria-label="Display settings">
      <div class="system-control">
        <span>Mode</span>
        <button type="button" data-theme-toggle aria-label="Switch light or dark mode">Dark</button>
      </div>
      <div class="system-control">
        <span>Text</span>
        <button type="button" data-copy-toggle aria-label="Switch discursive text style">Pink</button>
      </div>
    </div>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.dataset.style = 'rgb';

        const themeButton = document.querySelector('[data-theme-toggle]');
        if (themeButton) {
          const updateThemeLabel = () => {
            themeButton.textContent = root.dataset.theme === 'dark' ? 'Dark' : 'Light';
            themeButton.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
          };
          themeButton.addEventListener('click', () => {
            root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
            updateThemeLabel();
          });
          updateThemeLabel();
        }

        const copyButton = document.querySelector('[data-copy-toggle]');
        if (copyButton) {
          const savedCopyStyle = localStorage.getItem('portfolio-copy-style');
          if (savedCopyStyle === 'pink' || savedCopyStyle === 'plain') root.dataset.copyStyle = savedCopyStyle;
          const updateCopyLabel = () => {
            const pink = root.dataset.copyStyle !== 'plain';
            copyButton.textContent = pink ? 'Pink' : 'Plain';
            copyButton.setAttribute('aria-pressed', String(pink));
          };
          copyButton.addEventListener('click', () => {
            root.dataset.copyStyle = root.dataset.copyStyle === 'plain' ? 'pink' : 'plain';
            localStorage.setItem('portfolio-copy-style', root.dataset.copyStyle);
            updateCopyLabel();
          });
          updateCopyLabel();
        }

        const bioTrigger = document.querySelector('[data-bio-trigger]');
        const bioPopup = document.querySelector('[data-bio-popup]');
        const bioMore = document.querySelector('[data-bio-more]');
        const bioClose = document.querySelector('[data-bio-close]');
        const bioLines = [...document.querySelectorAll('[data-bio-line]')];
        const bioXoxox = document.querySelector('[data-bio-xoxox]');
        const bioContact = document.querySelector('[data-bio-contact]');
        if (!bioTrigger || !bioPopup || !bioLines.length) return;
        let visibleLines = 1;
        const updateBio = () => {
          bioLines.forEach((line, index) => { line.hidden = index >= visibleLines; });
          const complete = visibleLines >= bioLines.length;
          if (bioMore) {
            bioMore.hidden = complete;
            bioMore.textContent = ['BLA +', 'BLA BLA +', 'BLA BLA BLA +', 'BLA BLA BLA BLA +'][Math.min(visibleLines - 1, 3)];
          }
          if (bioXoxox) bioXoxox.hidden = !complete;
          if (bioContact) bioContact.hidden = !complete;
        };
        const openBio = () => {
          bioPopup.classList.add('is-open');
          bioPopup.setAttribute('aria-hidden', 'false');
          bioTrigger.setAttribute('aria-expanded', 'true');
          updateBio();
        };
        const closeBio = () => {
          bioPopup.classList.remove('is-open');
          bioPopup.setAttribute('aria-hidden', 'true');
          bioTrigger.setAttribute('aria-expanded', 'false');
          visibleLines = 1;
          window.setTimeout(updateBio, 220);
        };
        bioTrigger.addEventListener('click', () => bioPopup.classList.contains('is-open') ? closeBio() : openBio());
        bioMore?.addEventListener('click', () => {
          visibleLines = Math.min(bioLines.length, visibleLines + 1);
          updateBio();
        });
        bioClose?.addEventListener('click', closeBio);
        document.addEventListener('keydown', event => { if (event.key === 'Escape') closeBio(); });
        document.addEventListener('pointerdown', event => {
          if (!bioPopup.classList.contains('is-open') || bioPopup.contains(event.target) || bioTrigger.contains(event.target)) return;
          closeBio();
        });
        updateBio();
      })();
    </script>
    {isHome && <script is:inline>
      (() => {
        const gate = document.querySelector('[data-entry-gate]');
        if (!gate) return;
        const storageKey = 'portfolio-entry-v1';
        if (sessionStorage.getItem(storageKey) === 'done') {
          gate.remove();
          return;
        }
        let lines = [];
        try { lines = JSON.parse(gate.dataset.entryLines || '[]'); } catch {}
        const line = gate.querySelector('[data-entry-line]');
        const counter = gate.querySelector('[data-entry-counter]');
        const star = gate.querySelector('[data-entry-star]');
        const instruction = gate.querySelector('[data-entry-instruction]');
        const skip = gate.querySelector('[data-entry-skip]');
        let step = 0;
        const enter = () => {
          sessionStorage.setItem(storageKey, 'done');
          gate.classList.add('is-leaving');
          window.setTimeout(() => gate.remove(), 650);
        };
        const advance = () => {
          step += 1;
          gate.style.setProperty('--entry-step', String(step));
          if (step >= lines.length) {
            enter();
            return;
          }
          if (line) {
            line.classList.remove('is-changing');
            void line.offsetWidth;
            line.textContent = lines[step];
            line.classList.add('is-changing');
          }
          if (counter) counter.textContent = `0${step + 1} / 0${lines.length}`;
          if (instruction) instruction.textContent = step === lines.length - 1 ? 'ONE LAST TIME' : 'AGAIN';
          gate.insertAdjacentHTML('beforeend', `<i class="entry-star-trace" style="--trace-x:${18 + Math.random() * 64}%;--trace-y:${15 + Math.random() * 70}%">★</i>`);
        };
        star?.addEventListener('click', advance);
        skip?.addEventListener('click', enter);
      })();
    </script>}
    <script is:inline src={withBase('base-path.js')}></script>
    <script is:inline src={withBase('research-layout.js')}></script>
    <script is:inline src={withBase('home-loader.js')}></script>
    <script is:inline src={withBase('play-save.js')}></script>
    {projectDetail&&<script is:inline src={withBase('featured-gallery.js')}></script>}
  </body>
</html>
