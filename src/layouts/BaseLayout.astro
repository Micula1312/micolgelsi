---
import '../styles/global.css';
const { title = 'Micol Gelsi' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Micol Gelsi — artist and researcher" />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="site-name" href="/">Micol Gelsi</a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href="/#work">Work</a>
          <a href="/about">About</a>
        </nav>
      </header>
      <main class="page"><slot /></main>
    </div>
  </body>
</html>
