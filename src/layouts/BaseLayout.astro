---
import '../styles/global.css';
import '../styles/year-plane.css';
import '../styles/grid.css';
import '../styles/hacker.css';
import '../styles/glyph-hover.css';
import '../styles/outputs.css';
import '../styles/dashboard.css';
import '../styles/scrollbars.css';
import '../styles/header-clean.css';
import '../styles/compat.css';
import '../styles/project-panels.css';
import homeConfig from '../../config/home.json';
const { title = 'Micol Gelsi' } = Astro.props;
const base = import.meta.env.BASE_URL;
const baseNoSlash = base.replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(baseNoSlash, '').replace(/\/$/, '') || '/';
const isHome = pathname === '/';
const fixedShell = ['/', '/play-with-me'].includes(pathname);
const projectDetail = pathname.startsWith('/projects/') || pathname.startsWith('/exhibitions/');
const withBase = (path = '') => `${base}${String(path).replace(/^\//, '')}`;
const bioLines = homeConfig.bio;
const loader = homeConfig.loader;
---
<!doctype html>
<html lang="en" data-style="rgb" data-theme="dark" data-copy-style="pink" data-language="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Micol Gelsi — artist and researcher" />
    <meta name="theme-color" content="#080808" />
    <title>{title}</title>
  </head>
  <body data-fixed-shell={fixedShell ? 'true' : undefined} data-project-detail={projectDetail ? 'true' : undefined}>
    {isHome && loader.enabled && <section class="entry-gate" data-entry-gate data-entry-lines={JSON.stringify(loader.phrases)} data-entry-lines-it={JSON.stringify(loader.phrasesIt??loader.phrases)} data-again-label={loader.againInstruction} data-again-label-it={loader.againInstructionIt??loader.againInstruction} data-enter-label={loader.enterInstruction} data-enter-label-it={loader.enterInstructionIt??loader.enterInstruction} aria-label="Portfolio entrance">
      <p class="entry-counter" data-entry-counter>00 / {String(loader.phrases.length).padStart(2, '0')}</p>
      <p class="entry-fixed" data-en={loader.fixedText} data-it={loader.fixedTextIt??loader.fixedText}>{loader.fixedText}</p>
      <p class="entry-line" data-entry-line hidden></p>
      <button class="entry-star" type="button" data-entry-star aria-label="Generate a phrase">★</button>
      <p class="entry-instruction" data-entry-instruction data-en={loader.instruction} data-it={loader.instructionIt??loader.instruction}>{loader.instruction}</p>
      <div class="entry-exits">
        <a href={loader.radioUrl} target="_blank" rel="noopener noreferrer" data-en={loader.radioLabel} data-it={loader.radioLabelIt??loader.radioLabel}>{loader.radioLabel}</a>
        <button type="button" data-entry-skip data-en={loader.skipLabel} data-it={loader.skipLabelIt??loader.skipLabel}>{loader.skipLabel}</button>
      </div>
    </section>}
    <div class="shell">
      <header class="site-header">
        <div class="identity">
          <a class="site-name" href={base} aria-label="Micol Gelsi — home">MICOL GELSI</a>
        </div>
        <nav class="site-nav" aria-label="Main navigation">
          <a href={`${base}#projects`} aria-current={pathname === '/' ? 'page' : undefined} data-en="PROJECTS" data-it="PROGETTI">PROJECTS</a>
          <a href={withBase('cv/micol-gelsi-CV.pdf')} target="_blank" rel="noopener">CV</a>
          <a href={withBase('play-with-me/')} aria-current={pathname === '/play-with-me' ? 'page' : undefined} data-en="PLAY WITH ME" data-it="GIOCA CON ME">PLAY WITH ME</a>
          <button class="bio-trigger" type="button" data-bio-trigger aria-expanded="false" aria-controls="bio-popup" data-en="BLABLABIO +" data-it="BLABLABIO +">BLABLABIO +</button>
        </nav>
        <aside class="bio-popup" id="bio-popup" data-bio-popup aria-hidden="true">
          <div class="bio-popup-copy" aria-live="polite">
            {bioLines.map((line, index) => <p class="site-bio bio-popup-line" data-bio-line={index} data-en={line} data-it={(homeConfig.bioIt??bioLines)[index]??line} hidden={index > 0}>{line}</p>)}
          </div>
          <div class="bio-popup-footer">
            <button class="bio-more" type="button" data-bio-more>BLA +</button>
            <span class="bio-xoxox" data-bio-xoxox hidden>XOXOX</span>
            <a class="bio-contact" data-bio-contact href={withBase('play-with-me/')} hidden>KEEP IN TOUCH ↗</a>
            <button class="bio-close" type="button" data-bio-close aria-label="Close biography">ENOUGH FOR NOW ×</button>
          </div>
        </aside>
      </header>
      <main class="page"><slot /></main>
    </div>

    <div class="system-controls" aria-label="Display settings">
      <div class="system-control">
        <span data-en="Mode" data-it="Modo">Mode</span>
        <button type="button" data-theme-toggle aria-label="Switch light or dark mode">Dark</button>
      </div>
      <div class="system-control">
        <span data-en="Text" data-it="Testo">Text</span>
        <button type="button" data-copy-toggle aria-label="Switch discursive text style">Pink</button>
      </div>
      <div class="system-control">
        <span>Lang</span>
        <button type="button" data-language-toggle aria-label="Switch Italian or English">EN</button>
      </div>
    </div>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.dataset.style = 'rgb';

        const themeButton = document.querySelector('[data-theme-toggle]');
        if (themeButton) {
          const updateThemeLabel = () => {
            const italian = root.dataset.language === 'it';
            themeButton.textContent = root.dataset.theme === 'dark' ? (italian ? 'Scuro' : 'Dark') : (italian ? 'Chiaro' : 'Light');
            themeButton.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
          };
          themeButton.addEventListener('click', () => {
            root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
            updateThemeLabel();
          });
          updateThemeLabel();
        }

        const copyButton = document.querySelector('[data-copy-toggle]');
        if (copyButton) {
          const savedCopyStyle = localStorage.getItem('portfolio-copy-style');
          if (savedCopyStyle === 'pink' || savedCopyStyle === 'plain') root.dataset.copyStyle = savedCopyStyle;
          const updateCopyLabel = () => {
            const pink = root.dataset.copyStyle !== 'plain';
            const italian = root.dataset.language === 'it';
            copyButton.textContent = pink ? (italian ? 'Rosa' : 'Pink') : (italian ? 'Normale' : 'Plain');
            copyButton.setAttribute('aria-pressed', String(pink));
          };
          copyButton.addEventListener('click', () => {
            root.dataset.copyStyle = root.dataset.copyStyle === 'plain' ? 'pink' : 'plain';
            localStorage.setItem('portfolio-copy-style', root.dataset.copyStyle);
            updateCopyLabel();
          });
          updateCopyLabel();
        }

        const languageButton = document.querySelector('[data-language-toggle]');
        const uiTranslations = {
          'Projects':'Progetti','Year':'Anno','Context':'Contesto','Research':'Ricerca',
          'Artistic':'Artistico','Artistic practice':'Pratica artistica','Web development':'Sviluppo web',
          'Author':'Autrice','Type':'Tipologia','Start':'Inizio','End':'Fine','Status':'Stato',
          'Medium':'Medium','Collaborators':'Collaborazioni','Link':'Link','visit ↗':'visita ↗',
          'Artists involved':'Artisti coinvolti','Curated by':'A cura di','Credits':'Crediti',
          'Photo credits':'Crediti fotografici','Outputs':'Output','Critical texts':'Testi critici',
          'Publications':'Pubblicazioni','Communication':'Comunicazione','Links':'Link',
          'loading / enter':'caricamento / entra','Dark':'Scuro','Light':'Chiaro','Pink':'Rosa','Plain':'Normale'
        };
        const translateTextNodes = language => {
          const reverse = Object.fromEntries(Object.entries(uiTranslations).map(([en,it]) => [it,en]));
          const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
          let node;
          while ((node = walker.nextNode())) {
            if (node.parentElement?.closest('script,style,textarea,input,[data-en][data-it]')) continue;
            const raw=node.nodeValue,trimmed=raw.trim();
            if (!trimmed) continue;
            const translated=language==='it'?uiTranslations[trimmed]:reverse[trimmed];
            if (translated) node.nodeValue=raw.replace(trimmed,translated);
          }
        };
        const translateInterface = () => {
          const language = root.dataset.language === 'it' ? 'it' : 'en';
          document.documentElement.lang = language;
          document.querySelectorAll('[data-en][data-it]').forEach(element => {
            element.textContent = element.dataset[language] || element.dataset.en || '';
          });
          translateTextNodes(language);
          if (themeButton) {
            const italian = language === 'it';
            themeButton.textContent = root.dataset.theme === 'dark' ? (italian ? 'Scuro' : 'Dark') : (italian ? 'Chiaro' : 'Light');
          }
          if (copyButton) {
            const italian = language === 'it';
            copyButton.textContent = root.dataset.copyStyle !== 'plain' ? (italian ? 'Rosa' : 'Pink') : (italian ? 'Normale' : 'Plain');
          }
          if (languageButton) {
            languageButton.textContent = language.toUpperCase();
            languageButton.setAttribute('aria-pressed', String(language === 'it'));
          }
        };
        const savedLanguage = localStorage.getItem('portfolio-language');
        if (savedLanguage === 'it' || savedLanguage === 'en') root.dataset.language = savedLanguage;
        languageButton?.addEventListener('click', () => {
          root.dataset.language = root.dataset.language === 'it' ? 'en' : 'it';
          localStorage.setItem('portfolio-language', root.dataset.language);
          translateInterface();
          window.dispatchEvent(new CustomEvent('portfolio-language-change', { detail: root.dataset.language }));
        });
        translateInterface();

        const bioTrigger = document.querySelector('[data-bio-trigger]');
        const bioPopup = document.querySelector('[data-bio-popup]');
        const bioMore = document.querySelector('[data-bio-more]');
        const bioClose = document.querySelector('[data-bio-close]');
        const bioLines = [...document.querySelectorAll('[data-bio-line]')];
        const bioXoxox = document.querySelector('[data-bio-xoxox]');
        const bioContact = document.querySelector('[data-bio-contact]');
        if (!bioTrigger || !bioPopup || !bioLines.length) return;
        let visibleLines = 1;
        const updateBio = () => {
          bioLines.forEach((line, index) => { line.hidden = index >= visibleLines; });
          const complete = visibleLines >= bioLines.length;
          if (bioMore) {
            bioMore.hidden = complete;
            bioMore.textContent = ['BLA +', 'BLA BLA +', 'BLA BLA BLA +', 'BLA BLA BLA BLA +'][Math.min(visibleLines - 1, 3)];
          }
          if (bioXoxox) bioXoxox.hidden = !complete;
          if (bioContact) bioContact.hidden = !complete;
        };
        const openBio = () => {
          bioPopup.classList.add('is-open');
          bioPopup.setAttribute('aria-hidden', 'false');
          bioTrigger.setAttribute('aria-expanded', 'true');
          updateBio();
        };
        const closeBio = () => {
          bioPopup.classList.remove('is-open');
          bioPopup.setAttribute('aria-hidden', 'true');
          bioTrigger.setAttribute('aria-expanded', 'false');
          visibleLines = 1;
          window.setTimeout(updateBio, 220);
        };
        bioTrigger.addEventListener('click', () => bioPopup.classList.contains('is-open') ? closeBio() : openBio());
        bioMore?.addEventListener('click', () => {
          visibleLines = Math.min(bioLines.length, visibleLines + 1);
          updateBio();
        });
        bioClose?.addEventListener('click', closeBio);
        document.addEventListener('keydown', event => { if (event.key === 'Escape') closeBio(); });
        document.addEventListener('pointerdown', event => {
          if (!bioPopup.classList.contains('is-open') || bioPopup.contains(event.target) || bioTrigger.contains(event.target)) return;
          closeBio();
        });
        updateBio();
      })();
    </script>
    {isHome && <script is:inline>
      (() => {
        const gate = document.querySelector('[data-entry-gate]');
        if (!gate) return;
        const storageKey = 'portfolio-entry-v1';
        if (sessionStorage.getItem(storageKey) === 'done') {
          gate.remove();
          return;
        }
        let lines = [];
        const language = document.documentElement.dataset.language === 'it' ? 'it' : 'en';
        try { lines = JSON.parse(language === 'it' ? (gate.dataset.entryLinesIt || gate.dataset.entryLines || '[]') : (gate.dataset.entryLines || '[]')); } catch {}
        const line = gate.querySelector('[data-entry-line]');
        const counter = gate.querySelector('[data-entry-counter]');
        const star = gate.querySelector('[data-entry-star]');
        const instruction = gate.querySelector('[data-entry-instruction]');
        const skip = gate.querySelector('[data-entry-skip]');
        let step = 0;
        const enter = () => {
          sessionStorage.setItem(storageKey, 'done');
          gate.classList.add('is-leaving');
          window.setTimeout(() => gate.remove(), 650);
        };
        const advance = () => {
          if (step >= lines.length) {
            enter();
            return;
          }
          gate.style.setProperty('--entry-step', String(step + 1));
          if (line) {
            line.hidden = false;
            line.classList.remove('is-changing');
            void line.offsetWidth;
            line.textContent = lines[step];
            line.classList.add('is-changing');
          }
          step += 1;
          if (counter) counter.textContent = `0${step} / 0${lines.length}`;
          if (instruction) { const italian=language==='it'; instruction.textContent = step === lines.length ? (italian?(gate.dataset.enterLabelIt||gate.dataset.enterLabel):(gate.dataset.enterLabel||'TOUCH TO ENTER')) : (italian?(gate.dataset.againLabelIt||gate.dataset.againLabel):(gate.dataset.againLabel||'AGAIN')); }
          gate.insertAdjacentHTML('beforeend', `<i class="entry-star-trace" style="--trace-x:${12 + Math.random() * 76}%;--trace-y:${14 + Math.random() * 70}%;--trace-r:${-40 + Math.random() * 80}deg">★</i>`);
        };
        star?.addEventListener('click', advance);
        skip?.addEventListener('click', enter);
      })();
    </script>}
    <script is:inline src={withBase('base-path.js')}></script>
    <script is:inline src={withBase('research-layout.js')}></script>
    <script is:inline src={withBase('home-loader.js')}></script>
    <script is:inline src={withBase('play-save.js')}></script>
    {projectDetail&&<script is:inline src={withBase('featured-gallery.js')}></script>}
  </body>
</html>
