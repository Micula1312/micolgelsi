---
import '../styles/global.css';
import '../styles/year-plane.css';
import '../styles/grid.css';
import '../styles/hacker.css';
import '../styles/glyph-hover.css';
import '../styles/outputs.css';
import '../styles/dashboard.css';
import '../styles/scrollbars.css';
import '../styles/header-clean.css';
import '../styles/compat.css';
const { title = 'Micol Gelsi' } = Astro.props;
const base = import.meta.env.BASE_URL;
const baseNoSlash = base.replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(baseNoSlash, '').replace(/\/$/, '') || '/';
const isHome = pathname === '/';
const fixedShell = ['/', '/play-with-me'].includes(pathname);
const withBase = (path = '') => `${base}${String(path).replace(/^\//, '')}`;
const bioLines = [
  'Artist and researcher working across performative and multimedia arts.',
  'Her practice moves between physical and virtual spaces.',
  'She works with living archives, bodies, territories and digital systems.',
  'Memory, liminality and power recur as fields of investigation.',
  'She works with ASAP and BLIVET and is a member of Sound Studies Forum.'
];
---
<!doctype html>
<html lang="en" data-style="rgb" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Micol Gelsi — artist and researcher" />
    <meta name="theme-color" content="#080808" />
    <title>{title}</title>
  </head>
  <body data-fixed-shell={fixedShell ? 'true' : undefined}>
    <div class="shell">
      <header class="site-header">
        <div class="identity">
          <a class="site-name" href={base} aria-label="Micol Gelsi">MICOL GELSI</a>
          <p class="site-bio" data-type-bio={isHome ? 'true' : undefined} data-bio-lines={isHome ? JSON.stringify(bioLines) : undefined}>
            {bioLines.map((line, index) => <>{line}{index < bioLines.length - 1 && <br />}</>)}
          </p>
        </div>
        <nav class="site-nav" aria-label="Main navigation">
          <a href={`${base}#projects`} aria-current={pathname === '/' ? 'page' : undefined}>PROJECTS</a>
          <a href={withBase('cv/micol-gelsi-CV.pdf')} target="_blank" rel="noopener">CV</a>
          <a href={withBase('play-with-me/')} aria-current={pathname === '/play-with-me' ? 'page' : undefined}>PLAY WITH ME</a>
        </nav>
      </header>
      <main class="page"><slot /></main>
    </div>

    <div class="system-controls" aria-label="Display settings">
      <div class="system-control">
        <span>Mode</span>
        <button type="button" data-theme-toggle aria-label="Switch light or dark mode">Dark</button>
      </div>
    </div>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.dataset.style = 'rgb';
        const themeButton = document.querySelector('[data-theme-toggle]');
        if (themeButton) {
          const updateLabel = () => {
            themeButton.textContent = root.dataset.theme === 'dark' ? 'Dark' : 'Light';
            themeButton.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
          };
          themeButton.addEventListener('click', () => {
            root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
            updateLabel();
          });
          updateLabel();
        }

        const bio = document.querySelector('[data-type-bio="true"]');
        if (!bio) return;
        let lines = [];
        try { lines = JSON.parse(bio.dataset.bioLines || '[]'); } catch {}
        if (!lines.length || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        bio.setAttribute('aria-label', lines.join(' '));
        bio.innerHTML = '';
        const stream = lines.flatMap((line, i) => [...line, ...(i < lines.length - 1 ? ['\n'] : [])]);
        let i = 0;
        const tick = () => {
          const char = stream[i++];
          if (char === '\n') bio.appendChild(document.createElement('br'));
          else bio.appendChild(document.createTextNode(char));
          if (i < stream.length) window.setTimeout(tick, char === ' ' ? 9 : 18 + Math.random() * 20);
        };
        window.setTimeout(tick, 180);
      })();
    </script>
    <script is:inline src={withBase('base-path.js')}></script>
    <script is:inline src={withBase('research-layout.js')}></script>
    <script is:inline src={withBase('home-loader.js')}></script>
    <script is:inline src={withBase('play-save.js')}></script>
  </body>
</html>
