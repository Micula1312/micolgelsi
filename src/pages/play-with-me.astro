---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Play With Me — Micol Gelsi">
  <section class="board" aria-labelledby="play-title">
    <div class="board-toolbar">
      <div class="title-group">
        <span>PLAY WITH ME / 001</span>
        <h1 id="play-title">DRAW ON YOURSELF</h1>
      </div>
      <p>camera → draw → send</p>
    </div>

    <div class="play-panel">
      <div class="stage" data-stage>
        <video autoplay muted playsinline data-video></video>
        <canvas data-canvas></canvas>
        <div class="placeholder" data-placeholder>
          <span class="camera-mark">★</span>
          <button type="button" data-camera>ALLOW CAMERA</button>
        </div>
      </div>

      <div class="tool-row">
        <div class="tool-group">
          <button type="button" data-clear>CLEAR</button>
          <button type="button" data-undo>UNDO</button>
          <label>BRUSH <input type="range" min="1" max="40" value="7" data-brush /></label>
        </div>
        <button class="send" type="button" data-send>★ SEND ME</button>
      </div>
      <p class="note" data-note></p>
    </div>
  </section>

  <script is:inline>
    (() => {
      const stage = document.querySelector('[data-stage]');
      const video = document.querySelector('[data-video]');
      const canvas = document.querySelector('[data-canvas]');
      const placeholder = document.querySelector('[data-placeholder]');
      const brush = document.querySelector('[data-brush]');
      const note = document.querySelector('[data-note]');
      const ctx = canvas?.getContext('2d');
      if (!stage || !video || !canvas || !ctx) return;
      let drawing = false, last = null, history = [];

      const resize = () => {
        const r = stage.getBoundingClientRect(), dpr = devicePixelRatio || 1;
        const snapshot = canvas.width && canvas.height ? canvas.toDataURL() : null;
        canvas.width = Math.max(1, r.width * dpr);
        canvas.height = Math.max(1, r.height * dpr);
        canvas.style.width = `${r.width}px`;
        canvas.style.height = `${r.height}px`;
        ctx.setTransform(dpr,0,0,dpr,0,0);
        ctx.lineCap = 'round'; ctx.lineJoin = 'round';
        if (snapshot) { const img = new Image(); img.onload = () => ctx.drawImage(img,0,0,r.width,r.height); img.src = snapshot; }
      };
      resize(); window.addEventListener('resize', resize);
      const point = e => { const r=canvas.getBoundingClientRect(); return {x:e.clientX-r.left,y:e.clientY-r.top}; };
      canvas.addEventListener('pointerdown', e=>{ history.push(canvas.toDataURL()); drawing=true; last=point(e); canvas.setPointerCapture(e.pointerId); });
      canvas.addEventListener('pointermove', e=>{ if(!drawing)return; const n=point(e); ctx.strokeStyle=getComputedStyle(document.documentElement).getPropertyValue('--signal').trim()||'#39ff14'; ctx.lineWidth=Number(brush?.value||7); ctx.beginPath(); ctx.moveTo(last.x,last.y); ctx.lineTo(n.x,n.y); ctx.stroke(); last=n; });
      canvas.addEventListener('pointerup', ()=>{ drawing=false; last=null; });

      document.querySelector('[data-camera]')?.addEventListener('click', async()=>{
        try { video.srcObject=await navigator.mediaDevices.getUserMedia({video:{facingMode:'user'},audio:false}); placeholder.hidden=true; }
        catch { note.textContent='camera permission denied — draw on the void.'; }
      });
      document.querySelector('[data-clear]')?.addEventListener('click', ()=>{ history.push(canvas.toDataURL()); ctx.clearRect(0,0,canvas.width,canvas.height); });
      document.querySelector('[data-undo]')?.addEventListener('click', ()=>{ const s=history.pop(); if(!s)return; const img=new Image(); img.onload=()=>{const r=canvas.getBoundingClientRect();ctx.clearRect(0,0,r.width,r.height);ctx.drawImage(img,0,0,r.width,r.height)}; img.src=s; });
      document.querySelector('[data-send]')?.addEventListener('click', async()=>{
        const r=stage.getBoundingClientRect(), out=document.createElement('canvas'); out.width=r.width*2; out.height=r.height*2; const o=out.getContext('2d');
        o.save(); o.translate(out.width,0); o.scale(-1,1); if(video.videoWidth)o.drawImage(video,0,0,out.width,out.height); else {o.fillStyle='#000';o.fillRect(0,0,out.width,out.height);} o.restore(); o.drawImage(canvas,0,0,out.width,out.height);
        const blob=await new Promise(res=>out.toBlob(res,'image/png')); if(!blob)return; const file=new File([blob],`play-with-me-${Date.now()}.png`,{type:'image/png'});
        if(navigator.canShare?.({files:[file]})){ try{await navigator.share({files:[file],title:'★ DRAW ON YOURSELF',text:'send this sketch to micolg@gmail.com'}); note.textContent='shared ★'; return;}catch(e){if(e.name==='AbortError')return;} }
        const url=URL.createObjectURL(blob), a=document.createElement('a'); a.href=url; a.download=file.name; a.click(); setTimeout(()=>URL.revokeObjectURL(url),1000); location.href='mailto:micolg@gmail.com?subject=%E2%98%85%20DRAW%20ON%20YOURSELF&body=Attach%20the%20PNG%20that%20was%20just%20downloaded.'; note.textContent='PNG saved — attach it to the email that opened ★';
      });
    })();
  </script>

  <style>
    .board{height:100%;min-height:0;border:1px solid var(--line);padding:12px;display:grid;grid-template-rows:auto minmax(0,1fr);overflow:hidden}
    .board-toolbar{min-height:48px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;align-items:start;font-family:var(--mono);font-size:11px}.title-group{display:flex;gap:18px;align-items:baseline;min-width:0}.title-group>span,.board-toolbar p{color:var(--muted);margin:0}.title-group h1{font:inherit;font-weight:700;white-space:nowrap}.board-toolbar p{text-align:right}
    .play-panel{min-height:0;border:1px solid var(--line);padding:10px;display:grid;grid-template-rows:minmax(0,1fr) auto auto;overflow:hidden}.stage{position:relative;min-height:0;width:100%;height:100%;overflow:hidden;background:#050505}.stage video,.stage canvas{position:absolute;inset:0;width:100%;height:100%}.stage video{object-fit:cover;transform:scaleX(-1)}.stage canvas{z-index:2;touch-action:none;cursor:crosshair}.placeholder{position:absolute;inset:0;z-index:3;display:grid;place-content:center;gap:14px;text-align:center;background:#050505;color:#fff}.placeholder[hidden]{display:none}.camera-mark{font-size:clamp(42px,8vw,110px);line-height:1;color:var(--muted)}.placeholder button{border:0;background:none;color:inherit;padding:0;cursor:pointer;font-family:var(--mono);font-size:11px;font-weight:700}
    .tool-row{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:9px 0 2px;font-family:var(--mono);font-size:11px}.tool-group{display:flex;align-items:center;gap:16px;min-width:0}.tool-row button{border:0;background:none;padding:0;cursor:pointer;font:inherit}.tool-row label{display:flex;align-items:center;gap:7px}.tool-row input{width:100px}.send{font-weight:700!important;white-space:nowrap}.note{min-height:1.2em;margin:3px 0 0;color:var(--muted);font-family:var(--mono);font-size:10px}
    @media(max-width:760px){.board{padding:8px}.board-toolbar{min-height:58px;grid-template-columns:1fr;gap:3px}.title-group{display:grid;gap:2px}.title-group h1{white-space:normal}.board-toolbar p{text-align:left}.play-panel{padding:7px}.tool-row{align-items:flex-start;gap:8px}.tool-group{gap:8px;flex-wrap:wrap}.tool-row input{width:72px}.send{margin-left:auto}.camera-mark{font-size:46px}}
  </style>
</BaseLayout>
