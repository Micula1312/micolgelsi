---
import BaseLayout from '../layouts/BaseLayout.astro';
import entries from '../data/sbrd-diary.json';
const publicEntries = entries.filter(entry => entry.status === 'public').sort((a,b) => b.date.localeCompare(a.date));
const allKeywords = [...new Set(publicEntries.flatMap(entry => entry.keywords || []))].sort();
---

<BaseLayout title="SBRD DIARY — Micol Gelsi">
<section class="sbrd">
<header class="sbrd-head"><h1>SBRD DIARY</h1><div class="sbrd-filters"><button class="is-active" data-keyword="all">ALL</button>{allKeywords.map(keyword => <button data-keyword={keyword}>#{keyword}</button>)}</div></header>
<div class="sbrd-scroll"><div class="sbrd-line"></div><ol class="sbrd-timeline">{publicEntries.map(entry => <li class="sbrd-node" data-entry data-keywords={(entry.keywords||[]).join(' ')}><time>{entry.date.split('-').reverse().join('.')}</time><button class="sbrd-star" type="button" data-open={entry.id}>★</button></li>)}</ol></div>
{publicEntries.map(entry => <dialog class="sbrd-pop" data-popup={entry.id}><button class="sbrd-close" type="button" data-close>×</button><time>{entry.date.split('-').reverse().join('.')}</time>{entry.title && <h2>{entry.title}</h2>}<div class="sbrd-text">{entry.text.split('\n').map(line => <p>{line}</p>)}</div>{entry.images?.length > 0 && <div class="sbrd-images">{entry.images.map(image => <img src={image} alt="" loading="lazy" />)}</div>}{entry.links?.length > 0 && <div class="sbrd-links">{entry.links.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer"><span>{link.label || link.url}</span><b>↗</b>{link.note && <em>{link.note}</em>}</a>)}</div>}<div class="sbrd-tags">{entry.keywords?.map(keyword => <button data-popup-keyword={keyword}>#{keyword}</button>)}</div></dialog>)}
</section>
<style>
.sbrd{min-height:100vh;padding:90px 0 45px;overflow:hidden}.sbrd-head{padding:0 clamp(14px,3vw,42px);display:flex;align-items:flex-end;justify-content:space-between;gap:24px}.sbrd-head h1{margin:0;font:800 clamp(28px,5vw,70px)/.9 var(--mono);letter-spacing:-.06em}.sbrd-filters{display:flex;gap:5px;max-width:55vw;overflow-x:auto;scrollbar-width:none}.sbrd-filters::-webkit-scrollbar{display:none}.sbrd-filters button,.sbrd-tags button{border:1px solid var(--line);background:var(--bg);color:var(--fg);font:8px/1 var(--mono);padding:5px 7px;white-space:nowrap;cursor:pointer}.sbrd-filters button.is-active{background:#39ff14;color:#050505;border-color:#39ff14}.sbrd-scroll{position:relative;height:calc(100vh - 190px);min-height:430px;overflow-x:auto;overflow-y:hidden;scrollbar-width:none}.sbrd-scroll::-webkit-scrollbar{display:none}.sbrd-line{position:absolute;left:6vw;top:52%;height:1px;background:var(--line);width:max(88vw,calc(var(--entries, 1) * 190px))}.sbrd-timeline{position:relative;list-style:none;margin:0;padding:0 8vw;min-width:100%;width:max-content;height:100%;display:flex;align-items:center;gap:70px}.sbrd-node{width:120px;flex:0 0 120px;height:160px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;transition:opacity .25s}.sbrd-node:nth-child(even){transform:translateY(-58px)}.sbrd-node:nth-child(odd){transform:translateY(48px)}.sbrd-node time{font:8px/1 var(--mono);color:var(--muted)}.sbrd-star{border:0;background:transparent;color:var(--fg);font-size:clamp(28px,4vw,58px);line-height:1;cursor:pointer;transition:transform .22s,color .22s;filter:drop-shadow(0 0 0 transparent)}.sbrd-star:hover,.sbrd-star:focus-visible{transform:scale(1.65) rotate(9deg);color:#ff2bbd;filter:drop-shadow(0 0 14px #ff2bbd)}.sbrd-node.is-muted{opacity:.08;pointer-events:none}.sbrd-pop{width:min(680px,calc(100vw - 24px));max-height:82vh;overflow:auto;border:1px solid var(--fg);background:var(--bg);color:var(--fg);padding:clamp(18px,4vw,42px);box-shadow:12px 12px 0 #ff2bbd}.sbrd-pop::backdrop{background:rgba(0,0,0,.55);backdrop-filter:blur(2px)}.sbrd-close{position:absolute;right:9px;top:7px;border:0;background:transparent;color:inherit;font:22px/1 var(--mono);cursor:pointer}.sbrd-pop>time{font:8px/1 var(--mono);color:var(--muted)}.sbrd-pop h2{font:800 clamp(24px,5vw,54px)/.92 var(--mono);letter-spacing:-.05em;margin:10px 0 20px}.sbrd-text{font:italic clamp(18px,2.5vw,30px)/1.15 Georgia,'Times New Roman',serif;color:#ff2bbd}.sbrd-text p{margin:.45em 0}.sbrd-images{display:flex;gap:8px;overflow-x:auto;margin:24px 0;scrollbar-width:none}.sbrd-images::-webkit-scrollbar{display:none}.sbrd-images img{height:clamp(160px,32vh,330px);width:auto;max-width:80%;object-fit:cover}.sbrd-links{display:grid;gap:7px;margin:24px 0}.sbrd-links a{display:grid;grid-template-columns:1fr auto;gap:6px;border-top:1px solid var(--line);padding:10px 0;color:inherit;text-decoration:none;font:800 clamp(14px,2vw,22px)/1 var(--mono);text-transform:uppercase}.sbrd-links a:hover{color:#39ff14}.sbrd-links em{grid-column:1/-1;font:italic 12px/1.3 Georgia,'Times New Roman',serif;text-transform:none;color:#ff2bbd}.sbrd-tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:20px}@media(max-width:700px){.sbrd-head{align-items:flex-start;flex-direction:column}.sbrd-filters{max-width:100%;width:100%}.sbrd-scroll{height:70vh}.sbrd-pop{box-shadow:6px 6px 0 #ff2bbd}}
</style>
<script is:inline>
(()=>{const nodes=[...document.querySelectorAll('[data-entry]')],filters=[...document.querySelectorAll('[data-keyword]')];function filter(key){filters.forEach(b=>b.classList.toggle('is-active',b.dataset.keyword===key));nodes.forEach(n=>n.classList.toggle('is-muted',key!=='all'&&!n.dataset.keywords.split(' ').includes(key)))}filters.forEach(b=>b.onclick=()=>filter(b.dataset.keyword));document.querySelectorAll('[data-open]').forEach(b=>b.onclick=()=>document.querySelector('[data-popup="'+b.dataset.open+'"]')?.showModal());document.querySelectorAll('[data-popup]').forEach(d=>{d.querySelector('[data-close]')?.addEventListener('click',()=>d.close());d.addEventListener('click',e=>{if(e.target===d)d.close()})});document.querySelectorAll('[data-popup-keyword]').forEach(b=>b.onclick=()=>{filter(b.dataset.popupKeyword);b.closest('dialog')?.close()})})();
</script>
</BaseLayout>
