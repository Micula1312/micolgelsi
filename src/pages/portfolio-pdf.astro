<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Micol Gelsi — Selected Portfolio</title>
<style>
:root{--bg:#050505;--fg:#f3f3f0;--signal:#39ff14;--pink:#ff2bbd;--muted:#8a8a86;--line:#323232;--mono:ui-monospace,SFMono-Regular,Menlo,Monaco,"Roboto Mono","IBM Plex Mono",monospace;--serif:Georgia,"Times New Roman",serif}*{box-sizing:border-box}html,body{margin:0;background:#161616;color:var(--fg)}body{font-family:Arial,Helvetica,sans-serif}a{color:inherit}.toolbar{position:fixed;z-index:60;top:12px;right:12px;display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}button{border:1px solid var(--line);background:#090909;color:var(--fg);padding:8px 10px;font:9px var(--mono);text-transform:uppercase;cursor:pointer}.hint{position:fixed;z-index:59;left:12px;bottom:12px;background:var(--signal);color:#000;padding:7px 9px;font:9px/1.3 var(--mono)}.book{width:297mm;margin:18px auto 60px}.page{position:relative;width:297mm;height:210mm;min-height:210mm;max-height:210mm;background:var(--bg);padding:10mm 11mm;page-break-after:always;overflow:hidden;box-shadow:0 8px 34px rgba(0,0,0,.34)}.page::before,.page::after{content:"";position:absolute;left:11mm;right:11mm;border-top:1px solid var(--line)}.page::before{top:10mm}.page::after{bottom:10mm}.corner{position:absolute;font:8px var(--mono);color:var(--muted);text-transform:uppercase}.corner.tl{top:4mm;left:11mm}.corner.tr{top:4mm;right:11mm}.corner.bl{bottom:4mm;left:11mm}.corner.br{bottom:4mm;right:11mm}.cover-page{display:grid;grid-template-columns:1.6fr .8fr;gap:12mm}.cover-left{display:flex;flex-direction:column;justify-content:space-between;padding:10mm 0}.cover-title{margin:0;font:800 90px/.78 var(--mono);text-transform:uppercase}.cover-title .pink{font-family:var(--serif);font-style:italic;font-weight:400;text-transform:none;color:var(--pink)}.cover-sub{font:14px/1.34 var(--mono);max-width:145mm}.cover-right{border-left:1px solid var(--line);padding:13mm 0 12mm 9mm;display:flex;flex-direction:column;justify-content:space-between}.cover-meta{font:9px/1.45 var(--mono);text-transform:uppercase}.signal-word{font:italic 28px/.95 var(--serif);color:var(--signal)}.star{font-size:28px;color:var(--signal)}
.index-page{padding-top:18mm;padding-bottom:17mm;display:grid;grid-template-rows:auto 1fr;gap:7mm}.index-head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid var(--line);padding-bottom:4mm}.index-head h2{font:800 28px/.9 var(--mono);margin:0;text-transform:uppercase;letter-spacing:-.04em}.index-head h2::before{content:'./';color:var(--signal);font-size:.72em;margin-right:1.5mm}.index-head em{font:italic 14px var(--serif);color:var(--pink)}.index-list{display:flex;flex-direction:column;justify-content:flex-start;gap:0}.index-entry{display:grid;grid-template-columns:18mm minmax(0,1fr);gap:5mm;align-items:center;min-height:24mm;padding:3.5mm 1mm;border-bottom:1px solid var(--line);text-decoration:none!important;color:var(--signal)!important;background:transparent;transition:background .12s ease}.index-entry:first-child{border-top:1px solid var(--line)}.index-entry:hover{background:color-mix(in srgb,var(--signal) 5%,transparent)}.index-pages{font:700 8px/1 var(--mono);color:var(--muted)}.index-title{display:block;font:800 17px/.95 var(--mono);font-variant-caps:all-small-caps;text-transform:uppercase;letter-spacing:.025em;color:var(--signal)!important;text-decoration:none!important}.index-entry:link,.index-entry:visited,.index-entry:hover,.index-entry:active{color:var(--signal)!important;text-decoration:none!important}.index-entry:hover .index-title{text-shadow:0 0 6px color-mix(in srgb,var(--signal) 45%,transparent)}.index-empty{display:grid;place-items:center;height:100%;font:10px var(--mono);color:var(--muted)}
.project-set.is-hidden{display:none}.project-overview{display:grid;grid-template-rows:auto 1fr auto;gap:5mm;padding-top:18mm;padding-bottom:16mm}.project-head{display:flex;justify-content:space-between;align-items:end}.project-title{margin:0;font:800 30px/.88 var(--mono);text-transform:uppercase}.project-kicker{font:8px/1.35 var(--mono);text-align:right;text-transform:uppercase;color:var(--muted)}.project-main{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(58mm,.7fr);gap:7mm;min-height:0;overflow:hidden}.visual{min-height:0;height:100%;overflow:hidden;border:1px solid var(--line)}.visual img,.visual video{width:100%;height:100%;object-fit:cover}.project-copy{display:flex;flex-direction:column;border-left:1px solid var(--line);padding-left:6mm;min-height:0;overflow:hidden}.summary{font-size:12px;line-height:1.36}.facts{margin-top:auto}.fact{display:grid;grid-template-columns:25mm 1fr;gap:3mm;padding:2.2mm 0;border-top:1px solid var(--line);font-size:9px}.fact b{font:7px var(--mono);text-transform:uppercase;color:var(--muted)}.project-foot{display:flex;justify-content:space-between;font:8px var(--mono);text-transform:uppercase}.project-foot a{color:var(--signal);text-decoration:none}.page-no{color:var(--pink)}
.visual-page{padding-top:17mm;padding-bottom:16mm;display:grid;grid-template-rows:auto 1fr;gap:4mm}.visual-head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid var(--fg);padding-bottom:3mm}.visual-head h3{margin:0;font:800 22px/.9 var(--mono);text-transform:uppercase}.visual-head em{font:italic 13px var(--serif);color:var(--pink)}.visual-layout{min-height:0;overflow:hidden;display:grid;grid-template-columns:minmax(0,1fr) 62mm;gap:5mm}.visual-layout.gallery-only{grid-template-columns:1fr}.media-mosaic{height:100%;min-height:0;display:flex;flex-wrap:wrap;align-content:flex-start;align-items:flex-start;gap:1mm 1.2mm;overflow:hidden}.media-tile{position:relative;min-height:0}.media-tile img,.media-tile video{display:block;width:100%;height:auto;object-fit:contain}.media-mosaic.count-1 .media-tile{flex:1 1 100%;max-width:100%;height:100%}.media-mosaic.count-1 .media-tile img,.media-mosaic.count-1 .media-tile video{height:100%;max-height:142mm;object-position:left top}.media-mosaic.count-2{align-content:stretch}.media-mosaic.count-2 .media-tile{flex:1 1 calc(50% - .6mm);max-width:calc(50% - .6mm);height:100%}.media-mosaic.count-2 .media-tile img,.media-mosaic.count-2 .media-tile video{height:100%;max-height:142mm;object-position:left top}.media-mosaic.count-3 .media-tile{flex:1 1 calc(33.333% - 1mm);max-width:calc(33.333% - 1mm)}.media-mosaic.count-3 .media-tile img,.media-mosaic.count-3 .media-tile video{max-height:125mm}.media-mosaic.count-4{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-auto-flow:row;gap:1.5mm;align-content:start;width:100%}.media-mosaic.count-4 .media-tile{max-width:none;width:auto}.media-mosaic.count-4 .media-tile:nth-child(6n+1){grid-column:span 5}.media-mosaic.count-4 .media-tile:nth-child(6n+2){grid-column:span 3}.media-mosaic.count-4 .media-tile:nth-child(6n+3){grid-column:span 4}.media-mosaic.count-4 .media-tile:nth-child(6n+4){grid-column:span 4}.media-mosaic.count-4 .media-tile:nth-child(6n+5){grid-column:span 5}.media-mosaic.count-4 .media-tile:nth-child(6n+6){grid-column:span 3}.media-mosaic.count-4 .media-tile img,.media-mosaic.count-4 .media-tile video{width:100%;max-height:64mm;object-fit:contain;object-position:left top}.media-label{position:absolute;left:1mm;bottom:1mm;background:#050505;padding:.8mm 1mm;font:5.5px var(--mono);border:1px solid var(--line)}.media-label.video{color:var(--signal)}.moments-list{border-left:1px solid var(--line);padding-left:4mm;min-height:0;overflow:hidden}.moments-list h4{margin:0 0 3mm;font:italic 14px var(--serif);color:var(--signal)}.moment-row{padding:2mm 0;border-top:1px solid var(--line)}.moment-date{font:6px var(--mono);color:var(--pink)}.moment-title{display:block;margin-top:.8mm;font:800 8px var(--mono);text-transform:uppercase}.moment-meta{font:6px var(--mono);color:var(--muted)}.visual-empty{display:grid;place-items:center;height:100%;font:10px var(--mono);color:var(--muted)}
.editor-badge{display:none}.hidden-panel{position:fixed;z-index:58;right:12px;top:56px;width:360px;max-height:calc(100vh - 92px);overflow:auto;background:#050505;border:1px solid var(--line);padding:11px;display:none}.hidden-panel.open{display:block}.group-label{margin:12px 0 4px;color:var(--pink)}.toggle-row{display:grid;grid-template-columns:auto 1fr;gap:8px;padding:6px 0;border-top:1px solid #222;font:9px var(--mono)}
@page{size:A4 landscape;margin:0}@media print{html,body{background:#000;-webkit-print-color-adjust:exact;print-color-adjust:exact}.toolbar,.hint,.hidden-panel,.editor-badge{display:none!important}.book{width:auto;margin:0}.page{width:297mm;height:210mm;min-height:210mm;max-height:210mm;margin:0;box-shadow:none}.visual video,.media-tile video{display:none}.index-entry,.index-entry:link,.index-entry:visited{color:var(--signal)!important;text-decoration:none!important}.index-title{color:var(--signal)!important}}
</style></head><body>
<div class="toolbar"><button id="editBtn">EDIT ORDER</button><button id="selectBtn">SELECT ITEMS</button><button id="resetBtn">DEFAULT 5</button><button id="printBtn">PRINT / SAVE PDF</button></div><div class="hint">Each selected item = 2 pages: overview + gallery / moments. Galleries show up to 8 media per page.</div><div class="hidden-panel" id="hiddenPanel"><div id="toggleList"></div></div><main class="book"><section class="page cover-page"><div class="cover-left"><h1 class="cover-title">Micol<br/><span class="pink">Gelsi</span></h1><p class="cover-sub">MULTIMEDIA ARTIST AND RESEARCHER. PUBLIC + DIGITAL SPACES / WEB ARCHIVES / SITE-SPECIFICITY / PARTICIPATION / LOW-TECH SYSTEMS.</p></div><div class="cover-right"><div class="star">✦</div><div class="signal-word">the archive is alive</div><div class="cover-meta">ART / RESEARCH / WEB<br/>SELECTED PORTFOLIO</div></div></section><section class="page index-page"><div class="index-head"><h2>Selected Projects</h2><em>chronology / selected works</em></div><div class="index-list" id="indexList"></div></section><div id="projectPages">
{pool.map(entry=>{const cover=coverFor(entry),href=hrefFor(entry),year=entry.data.year||'',type=entry.data.displayType||entry.collection.replace(/s$/,''),itemKind=entry.collection==='works'?'work':'project',collectionKind=entry.collection==='exhibitions'?'exhibition':itemKind;const facts=[['Type',type],['Year',String(year)],['Medium',safeJoin(entry.data.medium)],['Research areas',safeJoin(entry.data.researchAreas)],['With',safeJoin(entry.data.collaborators)]].filter(([,v])=>v);const moments=momentsFor(entry).filter(m=>m.title);const momentVisuals=moments.map(m=>({src:momentMedia(m),label:String(m.title||''),href:String(m.href||'')})).filter(m=>m.src).slice(0,8);const galleryVisuals=mediaFor(entry).map(src=>withBase(src)).filter(Boolean).slice(0,8).map((src,i)=>({src,label:isVideo(src)?`Video ${i+1}`:`Image ${i+1}`,href:isVideo(src)?src:''}));const visuals=(momentVisuals.length?momentVisuals:galleryVisuals).slice(0,8);return <div class="project-set" data-id={`${entry.collection}:${entry.id}`} data-kind={itemKind} data-collection-kind={collectionKind} data-title={entry.data.title} data-year={year} data-type={type}><section class="page project-overview" id={`work-${entry.collection}-${entry.id}`}><header class="project-head"><h2 class="project-title">{entry.data.title}</h2><div class="project-kicker">{type}<br/>{year}</div></header><div class="project-main"><div class="visual">{cover?(isVideo(cover)?<video src={cover} muted loop playsinline autoplay></video>:<img src={cover} alt=""/>):null}</div><div class="project-copy"><p class="summary">{entry.data.summary}</p><div class="facts">{facts.map(([l,v])=><div class="fact"><b>{l}</b><span>{v}</span></div>)}</div></div></div><footer class="project-foot"><a href={href}>FULL PROJECT ONLINE ↗</a><div class="page-no overview-no">--</div></footer></section><section class="page visual-page"><div class="visual-head"><h3>{entry.data.title}</h3><em>{moments.length?'moments / traces':'gallery / moving images'}</em></div><div class={`visual-layout ${moments.length?'':'gallery-only'}`}>{visuals.length?<div class={`media-mosaic count-${Math.min(visuals.length,4)}`}>{visuals.map(v=><div class="media-tile">{isVideo(v.src)?<video src={v.src} muted loop playsinline autoplay></video>:<img src={v.src} alt=""/>}<span class="media-label">{v.label}</span></div>)}</div>:<div class="visual-empty">NO GALLERY MEDIA YET</div>}{moments.length>0&&<aside class="moments-list"><h4>moments</h4>{moments.slice(0,6).map(m=><div class="moment-row"><span class="moment-date">{m.date||year}</span><strong class="moment-title">{m.title}</strong><span class="moment-meta">{[m.location,m.type].filter(Boolean).join(' / ')}</span></div>)}</aside>}</div></section></div>})}</div><section class="page cover-page"><div class="cover-left"><h2 class="cover-title">Keep<br/><span class="pink">in touch</span></h2></div></section></main>
<script is:inline define:vars={{defaultVisibleIds}}>(()=>{const KEY='micol-portfolio-pdf-v5',pagesHost=document.getElementById('projectPages'),indexList=document.getElementById('indexList'),panel=document.getElementById('hiddenPanel'),toggleList=document.getElementById('toggleList');const sets=()=>[...pagesHost.querySelectorAll('.project-set')];const defaultState=()=>({order:sets().map(p=>p.dataset.id),hidden:sets().filter(p=>!defaultVisibleIds.includes(p.dataset.id)).map(p=>p.dataset.id)});let state=(()=>{try{return {...defaultState(),...JSON.parse(localStorage.getItem(KEY)||'{}')}}catch{return defaultState()}})();function persist(){localStorage.setItem(KEY,JSON.stringify(state))}function applyOrder(){const map=new Map(sets().map(p=>[p.dataset.id,p]));for(const id of state.order||[]){const p=map.get(id);if(p){pagesHost.appendChild(p);map.delete(id)}}}function render(){applyOrder();const hidden=new Set(state.hidden||[]);sets().forEach(p=>p.classList.toggle('is-hidden',hidden.has(p.dataset.id)));const visible=sets().filter(p=>!hidden.has(p.dataset.id));indexList.innerHTML='';let n=3;visible.forEach(p=>{p.querySelectorAll('.overview-no').forEach(e=>e.textContent=String(n).padStart(2,'0'));const a=document.createElement('a');a.className='index-entry';a.href='#'+p.querySelector('.project-overview').id;a.innerHTML=`<span class="index-pages">${String(n).padStart(2,'0')}–${String(n+1).padStart(2,'0')}</span><strong class="index-title">${p.dataset.title}</strong>`;indexList.appendChild(a);n+=2});toggleList.innerHTML='';sets().forEach(p=>{const label=document.createElement('label');label.className='toggle-row';label.innerHTML=`<input type="checkbox" ${hidden.has(p.dataset.id)?'':'checked'}><span>${p.dataset.title}</span>`;label.querySelector('input').onchange=e=>{const s=new Set(state.hidden||[]);e.target.checked?s.delete(p.dataset.id):s.add(p.dataset.id);state.hidden=[...s];persist();render()};toggleList.appendChild(label)})}document.getElementById('selectBtn').onclick=()=>panel.classList.toggle('open');document.getElementById('resetBtn').onclick=()=>{localStorage.removeItem(KEY);state=defaultState();render()};document.getElementById('printBtn').onclick=()=>window.print();render()})();</script></body></html>