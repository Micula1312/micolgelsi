import { getCollection } from 'astro:content';

const base=import.meta.env.BASE_URL;
const withBase=(src='')=>{const value=String(src||'');if(!value.startsWith('/')||value.startsWith('//')||value.startsWith(base))return value;return `${base}${value.replace(/^\/+/, '')}`;};
const asArray=(value)=>Array.isArray(value)?value:(value==null||value===''?[]:[value]);
const textList=(value)=>asArray(value).map(v=>String(v??'').trim()).filter(Boolean);
const safeJoin=(value)=>textList(value).join(', ');
const projects=await getCollection('projects');
const exhibitions=await getCollection('exhibitions');
const works=await getCollection('works');
const projectPool=[...projects,...exhibitions].sort((a,b)=>Number(b.data.year||0)-Number(a.data.year||0)||String(a.data.title||'').localeCompare(String(b.data.title||'')));
const workPool=[...works].sort((a,b)=>Number(b.data.year||0)-Number(a.data.year||0)||String(a.data.title||'').localeCompare(String(b.data.title||'')));
const pool=[...projectPool,...workPool];
const preferredDefaults=['exhibitions:the-archive-is-alive','projects:untamed-architectureXambient-rave','projects:archive-of-the-untamed','projects:silent-target','projects:abundance'];
const availableIds=new Set(pool.map(entry=>`${entry.collection}:${entry.id}`));
const defaultVisibleIds=preferredDefaults.filter(id=>availableIds.has(id));
const hrefFor=(entry)=>entry.collection==='projects'?`${base}projects/${entry.id}`:entry.collection==='exhibitions'?`${base}exhibitions/${entry.id}`:`${base}works/${entry.id}`;
const galleryFor=(entry)=>textList(entry?.data?.gallery);const videosFor=(entry)=>textList(entry?.data?.videos);const unifiedMediaFor=(entry)=>textList(entry?.data?.media);const momentsFor=(entry)=>asArray(entry?.data?.moments).filter(m=>m&&typeof m==='object');
const mediaFor=(entry)=>unifiedMediaFor(entry).length?unifiedMediaFor(entry):[...galleryFor(entry),...videosFor(entry)];
const coverFor=(entry)=>withBase(entry.data.cover||mediaFor(entry)[0]||entry.data.avatar||'');
const isVideo=(src='')=>/\.(mp4|webm|mov|m4v|ogv)(?:$|\?)/i.test(String(src||''));const momentMedia=(moment)=>withBase(textList(moment?.gallery)[0]||moment?.media||'');
