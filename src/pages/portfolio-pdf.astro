  .page::before{content:"";position:absolute;left:11mm;right:11mm;top:10mm;border-top:1px solid var(--line);pointer-events:none}.page::after{content:"";position:absolute;left:11mm;right:11mm;bottom:10mm;border-top:1px solid var(--line);pointer-events:none}
  .corner{position:absolute;font:8px var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:.07em}.corner.tl{top:4mm;left:11mm}.corner.tr{top:4mm;right:11mm}.corner.bl{bottom:4mm;left:11mm}.corner.br{bottom:4mm;right:11mm}
  .cover-page{display:grid;grid-template-columns:1.6fr .8fr;gap:12mm;align-items:stretch}.cover-left{display:flex;flex-direction:column;justify-content:space-between;padding-top:10mm;padding-bottom:10mm}.cover-title{margin:0;font:800 clamp(58px,8vw,118px)/.78 var(--mono);text-transform:uppercase;letter-spacing:-.09em}.cover-title .pink{font-family:var(--serif);font-style:italic;font-weight:400;text-transform:none;color:var(--pink);letter-spacing:-.045em}.cover-sub{font:14px/1.34 var(--mono);max-width:145mm;margin:0}.cover-right{border-left:1px solid var(--line);padding:13mm 0 12mm 9mm;display:flex;flex-direction:column;justify-content:space-between}.cover-meta{font:9px/1.45 var(--mono);text-transform:uppercase}.signal-word{font:italic 28px/.95 var(--serif);color:var(--signal);max-width:58mm}.star{font-size:28px;color:var(--signal)}

  .index-page{padding-top:20mm;padding-bottom:17mm;display:grid;grid-template-rows:auto 1fr;gap:7mm}.index-head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid var(--fg);padding-bottom:4mm}.index-head h2{font:800 38px/.88 var(--mono);margin:0;text-transform:uppercase;letter-spacing:-.06em}.index-head em{font:italic 18px var(--serif);color:var(--pink);padding-bottom:1mm}.index-list{display:flex;flex-direction:column;min-height:0}.index-entry{--entry-accent:var(--fg);display:grid;grid-template-columns:18mm 22mm minmax(0,1fr) 42mm 10mm;gap:4mm;align-items:center;min-height:23mm;padding:3.2mm 0;border-bottom:1px solid var(--line);text-decoration:none;color:var(--fg)}.index-entry:first-child{border-top:1px solid var(--line)}.index-entry:hover{background:color-mix(in srgb,var(--signal) 5%,transparent)}.index-entry:hover .index-title,.index-entry:hover .index-arrow{color:var(--signal)}.index-entry.is-exhibition{--entry-accent:var(--pink)}.index-entry.is-work{--entry-accent:var(--signal)}.index-pages{font:800 11px/1 var(--mono);color:var(--pink)}.index-year{font:800 12px/1 var(--mono)}.index-main{min-width:0}.index-title{display:block;font:800 18px/.95 var(--mono);text-transform:uppercase;letter-spacing:-.045em;transition:color .12s}.index-sub{display:flex;gap:3mm;align-items:center;margin-top:1.5mm;font:7px/1.15 var(--mono);text-transform:uppercase;color:var(--muted)}.index-kind{color:var(--entry-accent)}.index-type{font:italic 10px/1.2 var(--serif);color:var(--muted);text-align:right}.index-arrow{text-align:right;font:18px/1 var(--mono);color:var(--entry-accent)}.index-empty{display:grid;place-items:center;height:100%;font:10px var(--mono);color:var(--muted)}

  .project-set.is-hidden{display:none}.project-overview{display:grid;grid-template-rows:auto 1fr auto;gap:5mm;padding-top:18mm;padding-bottom:16mm}.project-head{display:grid;grid-template-columns:1fr auto;gap:9mm;align-items:end}.project-title{margin:0;font:800 30px/.88 var(--mono);text-transform:uppercase;letter-spacing:-.055em}.project-kicker{text-align:right;font:8px/1.35 var(--mono);text-transform:uppercase;color:var(--muted)}.project-main{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(58mm,.7fr);gap:7mm;min-height:0}.visual{position:relative;min-height:132mm;overflow:hidden;background:#0d0d0d;border:1px solid var(--line)}.visual img,.visual video{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.88) contrast(1.06)}.visual::after{content:"✦";position:absolute;right:5mm;bottom:4mm;color:var(--signal);font-size:18px;mix-blend-mode:difference}.project-copy{display:flex;flex-direction:column;border-left:1px solid var(--line);padding-left:6mm}.summary{font-size:12px;line-height:1.36;margin:0 0 6mm}.summary::first-letter{font-family:var(--serif);font-style:italic;color:var(--pink);font-size:22px}.facts{margin-top:auto}.fact{display:grid;grid-template-columns:25mm 1fr;gap:3mm;padding:2.2mm 0;border-top:1px solid var(--line);font-size:9px;line-height:1.3}.fact b{font:7px var(--mono);text-transform:uppercase;color:var(--muted)}.project-foot{display:flex;justify-content:space-between;gap:8mm;align-items:end;font:8px/1.3 var(--mono);text-transform:uppercase}.project-foot a{text-decoration:none;color:var(--signal)}.page-no{color:var(--pink)}
  .visual-page{padding-top:17mm;padding-bottom:16mm;display:grid;grid-template-rows:auto 1fr;gap:4mm}.visual-head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid var(--fg);padding-bottom:3mm}.visual-head h3{margin:0;font:800 22px/.9 var(--mono);text-transform:uppercase;letter-spacing:-.05em}.visual-head em{font:italic 13px var(--serif);color:var(--pink)}.visual-layout{min-height:0;display:grid;grid-template-columns:minmax(0,1fr) 62mm;gap:5mm}.visual-layout.gallery-only{grid-template-columns:1fr}.media-mosaic{min-height:0;height:100%;display:flex;flex-wrap:wrap;align-content:flex-start;align-items:flex-start;gap:1mm 1.2mm;overflow:hidden}.media-tile{position:relative;flex:0 0 14%;max-width:18%;background:transparent;min-height:0;align-self:flex-start}.media-tile:nth-child(8n+2){flex-basis:10%;max-width:13%}.media-tile:nth-child(8n+3){flex-basis:17%;max-width:20%}.media-tile:nth-child(8n+4){flex-basis:12%;max-width:15%}.media-tile:nth-child(8n+5){flex-basis:20%;max-width:23%}.media-tile:nth-child(8n+6){flex-basis:11%;max-width:14%}.media-tile:nth-child(8n+7){flex-basis:16%;max-width:19%}.media-tile:nth-child(8n+8){flex-basis:13%;max-width:16%}.media-tile img,.media-tile video{display:block;width:100%;height:auto;max-height:52mm;object-fit:contain;object-position:center}.media-label{position:absolute;left:1mm;bottom:1mm;background:#050505;color:var(--fg);padding:.8mm 1mm;font:5.5px/1 var(--mono);text-transform:uppercase;border:1px solid var(--line);opacity:.82}.media-label.video{color:var(--signal)}.moments-list{border-left:1px solid var(--line);padding-left:4mm;overflow:hidden}.moments-list h4{margin:0 0 3mm;font:italic 14px/1 var(--serif);color:var(--signal)}.moment-row{padding:2mm 0;border-top:1px solid var(--line)}.moment-date{font:6px/1 var(--mono);color:var(--pink);text-transform:uppercase}.moment-title{display:block;margin-top:.8mm;font:800 8px/1 var(--mono);text-transform:uppercase}.moment-meta{display:block;margin-top:.8mm;font:6px/1.2 var(--mono);color:var(--muted)}.visual-empty{display:grid;place-items:center;height:100%;border:1px solid var(--line);font:10px var(--mono);color:var(--muted)}
  .project-set[draggable="true"]{cursor:grab}.project-set.dragging{opacity:.34}.project-set.drop-before{outline:3px solid var(--signal);outline-offset:-3px}.editor-badge{position:absolute;top:12mm;right:11mm;z-index:3;display:none;background:var(--signal);color:#000;padding:4px 6px;font:8px var(--mono)}body.editing .project-set .editor-badge{display:block}.hidden-panel{position:fixed;z-index:58;right:12px;top:56px;width:360px;max-height:calc(100vh - 92px);overflow:auto;background:#050505;color:var(--fg);border:1px solid var(--line);padding:11px;display:none}.hidden-panel.open{display:block}.hidden-panel h2{font:10px var(--mono);margin:0 0 8px;text-transform:uppercase}.group-label{margin:12px 0 4px;padding-top:8px;border-top:1px solid var(--line);font:italic 13px var(--serif);color:var(--pink)}.toggle-row{display:grid;grid-template-columns:auto 1fr;gap:8px;align-items:start;padding:6px 0;border-top:1px solid #222;font:9px/1.25 var(--mono)}.toggle-row input{margin:1px 0 0}.toggle-row small{color:var(--muted)}.empty-note{font:10px/1.4 var(--mono);color:var(--muted);padding:8mm 0}
  @media(max-width:1000px){.book{width:100%;margin:0}.page{width:100%;min-height:100vh;padding:18px}.toolbar{position:sticky;top:0;padding:8px;background:#161616;right:auto}.hint{display:none}.cover-page,.project-main,.visual-layout{grid-template-columns:1fr}.cover-right,.project-copy,.moments-list{border-left:0;border-top:1px solid var(--line);padding-left:0;padding-top:12px}.visual{min-height:52vh}.media-mosaic{min-height:70vh;overflow:visible;gap:6px}.media-tile,.media-tile:nth-child(n){flex-basis:auto;max-width:31%;margin:0}.page::before,.page::after,.corner{display:none}.index-page{display:block}.index-head{margin-bottom:20px}.index-entry{grid-template-columns:46px 52px minmax(0,1fr) 90px 24px;gap:8px;min-height:70px}.index-title{font-size:14px}.index-type{font-size:9px}}
  @page{size:A4 landscape;margin:0}
  @media print{html,body{background:#000;-webkit-print-color-adjust:exact;print-color-adjust:exact}.toolbar,.hint,.hidden-panel,.editor-badge{display:none!important}.book{width:auto;margin:0}.page{width:297mm;height:210mm;min-height:210mm;margin:0;box-shadow:none;break-after:page;page-break-after:always}.page:last-child{break-after:auto;page-break-after:auto}.project-set{cursor:default}.visual video,.media-tile video{display:none}.index-entry{color:var(--fg)!important;text-decoration:none!important}}
</style>
</head>
<body>
<div class="toolbar"><button type="button" id="editBtn">EDIT ORDER</button><button type="button" id="selectBtn">SELECT ITEMS</button><button type="button" id="resetBtn">DEFAULT 5</button><button type="button" id="printBtn">PRINT / SAVE PDF</button></div>
<div class="hint">Each selected item = 2 pages: overview + gallery / moments. Index rows jump to the corresponding project.</div>
<div class="hidden-panel" id="hiddenPanel"><h2>Portfolio selection</h2><div id="toggleList"></div></div>
<main class="book" id="book">
  <section class="page cover-page"><span class="corner tl">Micol Gelsi / portfolio</span><span class="corner tr">2026</span><span class="corner bl">Rome ↔ Bologna</span><span class="corner br">selected works</span><div class="cover-left"><h1 class="cover-title">Micol<br/><span class="pink">Gelsi</span></h1><p class="cover-sub">MULTIMEDIA ARTIST AND RESEARCHER. PUBLIC + DIGITAL SPACES / WEB ARCHIVES / SITE-SPECIFICITY / PARTICIPATION / LOW-TECH SYSTEMS.</p></div><div class="cover-right"><div class="star">✦</div><div class="signal-word">the archive is alive</div><div class="cover-meta"><a href="https://micolgelsi.com" target="_blank" rel="noopener noreferrer">micolgelsi.com ↗</a><br/>ART / RESEARCH / WEB<br/>SELECTED PORTFOLIO</div></div></section>
  <section class="page index-page" id="indexPage"><span class="corner tl">Index / selected works</span><span class="corner tr">clickable index</span><span class="corner bl">interactive links active</span><span class="corner br">✦</span><div class="index-head"><h2>Selected<br/>Projects</h2><em>chronology / selected works</em></div><div class="index-list" id="indexList"></div></section>
  <div id="projectPages">
  {pool.map((entry)=>{
    const cover=coverFor(entry);const second=secondImageFor(entry);const href=hrefFor(entry);const year=entry.data.year||'';const type=entry.data.displayType||entry.collection.replace(/s$/,'');const itemKind=entry.collection==='works'?'work':'project';const collectionKind=entry.collection==='exhibitions'?'exhibition':itemKind;
    const facts=[['Type',type],['Year',String(year||'')],['Medium',safeJoin(entry.data.medium)],['Research areas',safeJoin(entry.data.researchAreas)],['With',safeJoin(entry.data.collaborators)]].filter(([,value])=>value);
    const moments=momentsFor(entry).filter(m=>m.title);
    const momentVisuals=moments.map(m=>({src:momentMedia(m),label:String(m.title||''),href:String(m.href||'')})).filter(m=>m.src).slice(0,8);
    const galleryVisuals=mediaFor(entry).map(src=>withBase(src)).filter(Boolean).slice(0,18).map((src,idx)=>({src,label:isVideo(src)?`Video ${idx+1}`:`Image ${idx+1}`,href:isVideo(src)?src:''}));
    const visuals=momentVisuals.length?momentVisuals:galleryVisuals;
    return <div class="project-set" draggable="false" data-id={`${entry.collection}:${entry.id}`} data-kind={itemKind} data-collection-kind={collectionKind} data-title={entry.data.title} data-year={year} data-type={type}>
      <section class="page project-overview" id={`work-${entry.collection}-${entry.id}`}>
        <span class="corner tl">{collectionKind}</span><span class="corner tr">{year}</span><span class="corner bl">Micol Gelsi</span><span class="corner br overview-no">--</span><span class="editor-badge">DRAG PROJECT</span>
        <header class="project-head"><h2 class="project-title">{entry.data.title}</h2><div class="project-kicker">{type}<br/>{year}</div></header>
        <div class="project-main"><div class="visual">{cover?(isVideo(cover)?<><video src={cover} muted loop playsinline autoplay></video>{second&&<img src={second} alt="" style="display:none"/>}</>:<img src={cover} alt=""/>):<div class="empty-note">NO COVER SELECTED</div>}</div><div class="project-copy"><p class="summary">{entry.data.summary||'Selected work from Micol Gelsi’s artistic and research practice.'}</p><div class="facts">{facts.map(([label,value])=><div class="fact"><b>{label}</b><span>{value}</span></div>)}</div></div></div>
        <footer class="project-foot"><div>{entry.data.mainLink?<a href={entry.data.mainLink} target="_blank" rel="noopener noreferrer">PROJECT LINK ↗</a>:<a href={href} target="_blank" rel="noopener noreferrer">FULL PROJECT ONLINE ↗</a>}</div><div class="page-no overview-no">--</div></footer>
      </section>
      <section class="page visual-page">
        <span class="corner tl">{collectionKind} / visual notes</span><span class="corner tr">{year}</span><span class="corner bl">gallery / moments</span><span class="corner br visual-no">--</span>
        <div class="visual-head"><h3>{entry.data.title}</h3><em>{moments.length?'moments / traces':'gallery / moving images'}</em></div>
        <div class={`visual-layout ${moments.length?'':'gallery-only'}`}>
          {visuals.length?<div class="media-mosaic">{visuals.map(v=><div class="media-tile">{isVideo(v.src)?<><video src={v.src} muted loop playsinline autoplay></video><a class="media-label video" href={v.href||v.src} target="_blank" rel="noopener noreferrer">VIDEO ↗</a></>:<><img src={v.src} alt=""/><span class="media-label">{v.label}</span></>}</div>)}</div>:<div class="visual-empty">NO GALLERY MEDIA YET</div>}
          {moments.length>0&&<aside class="moments-list"><h4>moments</h4>{moments.slice(0,8).map(m=><div class="moment-row"><span class="moment-date">{m.date||year}</span><strong class="moment-title">{m.title}</strong>{(m.location||m.type)&&<span class="moment-meta">{[m.location,m.type].filter(Boolean).join(' / ')}</span>}</div>)}</aside>}
        </div>
      </section>
    </div>;
  })}
  </div>
  <section class="page cover-page end-page"><span class="corner tl">Contact</span><span class="corner tr">Micol Gelsi</span><span class="corner bl">Rome / Italy</span><span class="corner br">✦</span><div class="cover-left"><h2 class="cover-title">Keep<br/><span class="pink">in touch</span></h2></div><div class="cover-right"><div class="signal-word">play with me</div><div class="cover-meta"><a href="https://micolgelsi.com" target="_blank" rel="noopener noreferrer">micolgelsi.com ↗</a><br/><a href="mailto:micol.gelsi@gmail.com">micol.gelsi@gmail.com ↗</a><br/><br/>MULTIMEDIA ART / RESEARCH / WEB</div></div></section>
</main>
<script is:inline define:vars={{ defaultVisibleIds }}>
(()=>{
  const KEY='micol-portfolio-pdf-v5';
  const body=document.body,pagesHost=document.getElementById('projectPages'),indexList=document.getElementById('indexList'),panel=document.getElementById('hiddenPanel'),toggleList=document.getElementById('toggleList');
  const sets=()=>[...pagesHost.querySelectorAll('.project-set')];
  const defaultState=()=>({order:sets().map(p=>p.dataset.id),hidden:sets().filter(p=>!defaultVisibleIds.includes(p.dataset.id)).map(p=>p.dataset.id)});
  const read=()=>{try{return {...defaultState(),...JSON.parse(localStorage.getItem(KEY)||'{}')}}catch{return defaultState()}};let state=read(),dragged=null;
  function persist(){localStorage.setItem(KEY,JSON.stringify(state));}
  function applyOrder(){const map=new Map(sets().map(p=>[p.dataset.id,p]));for(const id of state.order||[]){const p=map.get(id);if(p){pagesHost.appendChild(p);map.delete(id)}}for(const p of map.values())pagesHost.appendChild(p);state.order=sets().map(p=>p.dataset.id);}
  function addGroup(title){const el=document.createElement('div');el.className='group-label';el.textContent=title;toggleList.appendChild(el);}
  function escapeHtml(value=''){return String(value).replace(/[&<>'"]/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[ch]));}
  function renderIndex(visible){indexList.innerHTML='';if(!visible.length){indexList.innerHTML='<div class="index-empty">SELECT AT LEAST ONE PROJECT</div>';return;}let pageNo=3;visible.forEach(p=>{const kind=p.dataset.collectionKind||p.dataset.kind||'project',a=document.createElement('a'),target=p.querySelector('.project-overview');a.className=`index-entry is-${kind}`;a.href=`#${target.id}`;a.innerHTML=`<span class="index-pages">${String(pageNo).padStart(2,'0')}–${String(pageNo+1).padStart(2,'0')}</span><span class="index-year">${escapeHtml(p.dataset.year||'—')}</span><span class="index-main"><strong class="index-title">${escapeHtml(p.dataset.title||'Untitled')}</strong><span class="index-sub"><span class="index-kind">${escapeHtml(kind)}</span><span>selected work</span></span></span><span class="index-type">${escapeHtml(p.dataset.type||kind)}</span><span class="index-arrow">↘</span>`;indexList.appendChild(a);pageNo+=2;});}
  function render(){applyOrder();const hidden=new Set(state.hidden||[]);sets().forEach(p=>p.classList.toggle('is-hidden',hidden.has(p.dataset.id)));toggleList.innerHTML='';let n=3;const visible=sets().filter(p=>!hidden.has(p.dataset.id));visible.forEach(p=>{p.querySelectorAll('.overview-no').forEach(el=>el.textContent=String(n).padStart(2,'0'));p.querySelectorAll('.visual-no').forEach(el=>el.textContent=String(n+1).padStart(2,'0'));n+=2;});renderIndex(visible);['project','work'].forEach(kind=>{const group=sets().filter(p=>p.dataset.kind===kind);if(!group.length)return;addGroup(kind==='project'?'PROJECTS / EXHIBITIONS':'WORKS / COMMERCIAL ADD-ONS');group.forEach(p=>{const visible=!hidden.has(p.dataset.id),label=document.createElement('label');label.className='toggle-row';label.innerHTML=`<input type="checkbox" ${visible?'checked':''}><span>${escapeHtml(p.dataset.title)}<br><small>${escapeHtml(p.dataset.year||'')} · ${escapeHtml(p.dataset.type||'')} · 2 pages</small></span>`;label.querySelector('input').onchange=e=>{const set=new Set(state.hidden||[]);e.target.checked?set.delete(p.dataset.id):set.add(p.dataset.id);state.hidden=[...set];persist();render();};toggleList.appendChild(label);});});}
  document.getElementById('editBtn').onclick=()=>{body.classList.toggle('editing');const on=body.classList.contains('editing');sets().forEach(p=>p.draggable=on);document.getElementById('editBtn').textContent=on?'DONE ORDER':'EDIT ORDER';};document.getElementById('selectBtn').onclick=()=>panel.classList.toggle('open');document.getElementById('resetBtn').onclick=()=>{localStorage.removeItem(KEY);state=defaultState();render();};document.getElementById('printBtn').onclick=()=>window.print();
  pagesHost.addEventListener('dragstart',e=>{const p=e.target.closest('.project-set');if(!p||!body.classList.contains('editing'))return;dragged=p;p.classList.add('dragging');e.dataTransfer.effectAllowed='move';});pagesHost.addEventListener('dragend',()=>{sets().forEach(p=>p.classList.remove('dragging','drop-before'));dragged=null;state.order=sets().map(p=>p.dataset.id);persist();render();});pagesHost.addEventListener('dragover',e=>{if(!dragged)return;e.preventDefault();const target=e.target.closest('.project-set');if(!target||target===dragged)return;sets().forEach(p=>p.classList.remove('drop-before'));target.classList.add('drop-before');const rect=target.getBoundingClientRect();if(e.clientY<rect.top+rect.height/2)pagesHost.insertBefore(dragged,target);else pagesHost.insertBefore(dragged,target.nextSibling);});render();
})();
</script>
</body>
</html>