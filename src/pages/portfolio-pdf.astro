function makeDraggable(tile){if(tile.dataset.ready)return;tile.dataset.ready='1';tile.addEventListener('pointerdown',e=>{if(!editing||gridMode||e.target.classList.contains('resize-handle'))return;e.preventDefault();materialize(tile);tile.style.zIndex=String(++zTop);const mosaic=tile.closest('.media-mosaic'),mr=mosaic.getBoundingClientRect(),startX=e.clientX,startY=e.clientY,startL=parseFloat(tile.style.left)||0,startT=parseFloat(tile.style.top)||0;tile.setPointerCapture(e.pointerId);const move=ev=>{tile.style.left=(startL+(ev.clientX-startX)/mr.width*100)+'%';tile.style.top=(startT+(ev.clientY-startY)/mr.height*100)+'%'};const up=()=>{tile.removeEventListener('pointermove',move);tile.removeEventListener('pointerup',up);tile.removeEventListener('pointercancel',up);saveTile(tile)};tile.addEventListener('pointermove',move);tile.addEventListener('pointerup',up);tile.addEventListener('pointercancel',up)});const handle=tile.querySelector('.resize-handle');handle?.addEventListener('pointerdown',e=>{if(!editing||gridMode)return;e.preventDefault();e.stopPropagation();materialize(tile);tile.style.zIndex=String(++zTop);const mosaic=tile.closest('.media-mosaic'),mr=mosaic.getBoundingClientRect(),startX=e.clientX,startW=tile.getBoundingClientRect().width/mr.width*100;handle.setPointerCapture(e.pointerId);const move=ev=>{tile.style.width=Math.max(8,startW+(ev.clientX-startX)/mr.width*100)+'%'};const up=()=>{handle.removeEventListener('pointermove',move);handle.removeEventListener('pointerup',up);handle.removeEventListener('pointercancel',up);saveTile(tile)};handle.addEventListener('pointermove',move);handle.addEventListener('pointerup',up);handle.addEventListener('pointercancel',up)})}
function createLocalTile(mosaic,item,save=true){const tile=document.createElement('div');tile.className='media-tile';tile.dataset.tileId=item.id;tile.dataset.local='1';tile.innerHTML=`<img alt=""/><span class="media-label">LOCAL IMAGE</span><i class="resize-handle"></i>`;tile.querySelector('img').src=item.src;mosaic.appendChild(tile);makeDraggable(tile);mosaic.classList.add('has-custom-layout');applyTileState(tile,item.layout||{x:10,y:10,w:34,z:++zTop});if(save){const key=pageKeyFor(mosaic),p=ensurePageState(key);p.added.push({id:item.id,src:item.src});p.tiles[item.id]={x:10,y:10,w:34,z:++zTop};persistLayouts()}return tile}
function restoreLayouts(){document.querySelectorAll('.visual-page').forEach(page=>{const key=page.dataset.layoutKey,p=layouts[key],mosaic=page.querySelector('.media-mosaic');if(!mosaic)return;[...mosaic.querySelectorAll('.media-tile')].forEach(makeDraggable);if(!p)return;(p.added||[]).forEach((item,i)=>{if(!mosaic.querySelector(`[data-tile-id="${item.id}"]`))createLocalTile(mosaic,{...item,layout:p.tiles?.[item.id]||{x:10+i*4,y:10+i*4,w:34,z:20+i}},false)});Object.entries(p.tiles||{}).forEach(([id,data])=>{const tile=mosaic.querySelector(`[data-tile-id="${id}"]`);if(tile)applyTileState(tile,data)})})}
function fileToDataURL(file){return new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(file)})}
function setupDrop(mosaic){['dragenter','dragover'].forEach(type=>mosaic.addEventListener(type,e=>{if(!editing||gridMode)return;e.preventDefault();mosaic.classList.add('drop-target')}));['dragleave','drop'].forEach(type=>mosaic.addEventListener(type,e=>{if(!editing||gridMode)return;e.preventDefault();if(type==='dragleave'&&e.relatedTarget&&mosaic.contains(e.relatedTarget))return;mosaic.classList.remove('drop-target')}));mosaic.addEventListener('drop',async e=>{if(!editing||gridMode)return;const files=[...e.dataTransfer.files].filter(f=>f.type.startsWith('image/'));if(!files.length)return;for(const [i,file] of files.entries()){const src=await fileToDataURL(file),id=`local-${Date.now()}-${i}-${Math.random().toString(36).slice(2,7)}`,tile=createLocalTile(mosaic,{id,src},true);const mr=mosaic.getBoundingClientRect(),x=(e.clientX-mr.left)/mr.width*100+i*3,y=(e.clientY-mr.top)/mr.height*100+i*3;tile.style.left=x+'%';tile.style.top=y+'%';saveTile(tile)}})}
document.querySelectorAll('.media-mosaic').forEach(m=>{[...m.querySelectorAll('.media-tile')].forEach(makeDraggable);setupDrop(m)});restoreLayouts();applyGridMode();
gridBtn.onclick=()=>{gridMode=!gridMode;localStorage.setItem(GRID_KEY,gridMode?'1':'0');applyGridMode()};
editBtn.onclick=()=>{if(gridMode){gridMode=false;localStorage.setItem(GRID_KEY,'0');applyGridMode()}editing=!editing;document.body.classList.toggle('layout-editing',editing);editBtn.classList.toggle('active',editing);editBtn.textContent=editing?'DONE EDITING':'EDIT LAYOUT';hint.textContent=editing?'DRAG images · drag pink corner to resize · DROP JPG/PNG/WEBP from desktop onto a gallery page':'4–8 media use a loose overlapping archive layout.';if(editing)document.querySelectorAll('.media-tile').forEach(materialize)};
document.getElementById('selectBtn').onclick=()=>panel.classList.toggle('open');document.getElementById('resetLayoutBtn').onclick=()=>{if(confirm('Reset all manual image positions and locally dropped images?')){localStorage.removeItem(LAYOUT_KEY);location.reload()}};document.getElementById('resetBtn').onclick=()=>{localStorage.removeItem(KEY);state=defaultState();render()};document.getElementById('printBtn').onclick=()=>window.print();render();
})();</script></body></html>