---
import { getCollection } from 'astro:content';

const base=import.meta.env.BASE_URL;
const withBase=(src='')=>{const value=String(src||'');if(!value.startsWith('/')||value.startsWith('//')||value.startsWith(base))return value;return `${base}${value.replace(/^\/+/, '')}`;};
const asArray=(value)=>Array.isArray(value)?value:(value==null||value===''?[]:[value]);
const textList=(value)=>asArray(value).map(v=>String(v??'').trim()).filter(Boolean);
const safeJoin=(value)=>textList(value).join(', ');
const projects=await getCollection('projects');
const exhibitions=await getCollection('exhibitions');
const works=await getCollection('works');

const projectPool=[...projects,...exhibitions]
  .sort((a,b)=>Number(b.data.year||0)-Number(a.data.year||0)||String(a.data.title||'').localeCompare(String(b.data.title||'')));
const workPool=[...works]
  .sort((a,b)=>Number(b.data.year||0)-Number(a.data.year||0)||String(a.data.title||'').localeCompare(String(b.data.title||'')));
const pool=[...projectPool,...workPool];
const preferredDefaults=[
  'exhibitions:the-archive-is-alive',
  'projects:untamed-architectureXambient-rave',
  'projects:archive-of-the-untamed',
  'projects:silent-target',
  'projects:abundance'
];
const availableIds=new Set(pool.map(entry=>`${entry.collection}:${entry.id}`));
const defaultVisibleIds=preferredDefaults.filter(id=>availableIds.has(id));
const hrefFor=(entry)=>entry.collection==='projects'?`${base}projects/${entry.id}`:entry.collection==='exhibitions'?`${base}exhibitions/${entry.id}`:`${base}works/${entry.id}`;
const galleryFor=(entry)=>textList(entry?.data?.gallery);
const videosFor=(entry)=>textList(entry?.data?.videos);
const unifiedMediaFor=(entry)=>textList(entry?.data?.media);
const momentsFor=(entry)=>asArray(entry?.data?.moments).filter(m=>m&&typeof m==='object');
const mediaFor=(entry)=>unifiedMediaFor(entry).length?unifiedMediaFor(entry):[...galleryFor(entry),...videosFor(entry)];
const coverFor=(entry)=>withBase(entry.data.cover||mediaFor(entry)[0]||entry.data.avatar||'');
const secondImageFor=(entry)=>withBase(mediaFor(entry).find(src=>withBase(src)!==coverFor(entry))||'');
const isVideo=(src='')=>/\.(mp4|webm|mov|m4v|ogv)(?:$|\?)/i.test(String(src||''));
const momentMedia=(moment)=>withBase(textList(moment?.gallery)[0]||moment?.media||'');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Micol Gelsi — Selected Portfolio</title>
<style>
  :root{--bg:#050505;--fg:#f3f3f0;--signal:#39ff14;--pink:#ff2bbd;--muted:#8a8a86;--line:#323232;--mono:ui-monospace,SFMono-Regular,Menlo,Monaco,"Roboto Mono","IBM Plex Mono",monospace;--serif:Georgia,"Times New Roman",serif}
  *{box-sizing:border-box}html,body{margin:0;background:#161616;color:var(--fg)}body{font-family:Arial,Helvetica,sans-serif}a{color:inherit}
  .toolbar{position:fixed;z-index:60;top:12px;right:12px;display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;max-width:min(900px,calc(100vw - 24px))}
  button{border:1px solid var(--line);background:#090909;color:var(--fg);padding:8px 10px;font:9px var(--mono);text-transform:uppercase;cursor:pointer}button:hover{border-color:var(--signal);color:var(--signal)}
