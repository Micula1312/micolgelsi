.hyper-hero{position:relative;isolation:isolate;overflow:hidden}.hyper-hero>span,.hyper-hero>h1,.hyper-hero>p,.hyper-hero>small{position:relative;z-index:1}.hyper-hero-stars{position:absolute;inset:0;pointer-events:none;z-index:0}.hyper-hero-stars span{position:absolute;font:clamp(16px,3vw,42px)/1 monospace;color:var(--hyper-accent);opacity:.65;animation:hyper-twinkle 4s ease-in-out infinite alternate}.hyper-hero-stars span:nth-child(1){left:8%;top:18%;animation-delay:-.3s}.hyper-hero-stars span:nth-child(2){left:84%;top:12%;animation-delay:-2s}.hyper-hero-stars span:nth-child(3){left:69%;top:44%;animation-delay:-1s}.hyper-hero-stars span:nth-child(4){left:94%;top:68%;animation-delay:-3s}.hyper-hero-stars span:nth-child(5){left:35%;top:8%;animation-delay:-2.6s}.hyper-hero-stars span:nth-child(6){left:55%;top:82%;animation-delay:-1.5s}.hyper-hero-stars span:nth-child(7){left:14%;top:76%;animation-delay:-.8s}.hyper-hero-stars span:nth-child(8){left:75%;top:90%;animation-delay:-3.3s}.hyper-hero-stars span:nth-child(9){left:96%;top:29%;animation-delay:-1.8s}.hyper-hero-stars span:nth-child(10){left:44%;top:54%;animation-delay:-2.8s}.hyper-hero-stars span:nth-child(11){left:3%;top:49%;animation-delay:-.9s}.hyper-hero-stars span:nth-child(12){left:61%;top:14%;animation-delay:-3.6s}@keyframes hyper-twinkle{0%{transform:scale(.65) rotate(-12deg);opacity:.2}100%{transform:scale(1.35) rotate(18deg);opacity:.9}}
.hyper-loop{border:1px solid var(--hyper-line);padding:clamp(16px,3vw,36px);margin-top:24px}.hyper-loop-step{border-top:1px solid var(--hyper-line);padding:16px 0}.hyper-loop-step span{font-size:clamp(13px,2vw,22px);color:var(--hyper-accent)}.hyper-loop-step p{margin:8px 0 0}.hyper-loop-arrow{font-size:28px;color:var(--hyper-accent);text-align:center}.hyper-loop-return{border-top:1px dashed var(--hyper-accent);padding:18px 0 0;color:var(--hyper-accent);font-size:11px;letter-spacing:.05em}@media(prefers-reduced-motion:reduce){.hyper-hero-stars span{animation:none!important}}

