/* Previous research: text-first, restrained, with no photographic effects. */
.hyper-previous-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:32px}
.hyper-previous-links>a,.hyper-pending-link{display:flex;flex-direction:column;justify-content:space-between;gap:20px;min-height:115px;padding:14px;border:1px solid var(--hyper-line);font:400 clamp(12px,1.6vw,17px)/1.3 "Courier New",monospace;text-decoration:none}
.hyper-previous-links>a:hover{border-color:var(--hyper-accent);color:var(--hyper-accent)}
.hyper-previous-links :is(a,.hyper-pending-link)>span{font-size:10px;opacity:.65}
.hyper-pending-link{opacity:.6}
.hyper-pending-link small{font-size:9px}
@media(max-width:600px){.hyper-previous-links{grid-template-columns:1fr}}
.hyper-genealogy{margin:30px 0}.hyper-genealogy-item{display:grid;grid-template-columns:minmax(145px,28%) 1fr;gap:20px;padding:22px 0;border-top:1px solid var(--hyper-line)}.hyper-genealogy-item>span{font:11px/1.4 "Courier New",monospace;color:var(--hyper-accent)}.hyper-genealogy-item h3{font-size:clamp(15px,1.6vw,20px);text-transform:none;margin-bottom:10px}.hyper-genealogy-item p{margin-bottom:0}.hyper-genealogy-item:nth-child(even){padding-left:clamp(0px,2vw,20px)}@media(max-width:640px){.hyper-genealogy-item{grid-template-columns:1fr;gap:9px}.hyper-genealogy-item:nth-child(even){padding-left:0}}
.hyperarchive .hyper-diagram .wires{stroke-width:.55!important;opacity:.42}.hyperarchive .hyper-diagram .nodes{stroke-width:.65!important}.hyperarchive .hyper-diagram .accent-wires{stroke-width:.65!important}.hyperarchive .hyper-diagram .accent-wires path,.hyperarchive .hyper-diagram .accent-wires circle,.hyperarchive .hyper-diagram .accent-wires rect{stroke-width:.65!important}.hyperarchive .hyper-section p{line-height:1.65}.hyperarchive .hyper-genealogy-item p{max-width:570px}
.hyperarchive .hyper-diagram .wires{stroke-width:.48!important;stroke-linecap:round;stroke-linejoin:round}.hyperarchive .hyper-diagram .nodes{stroke-width:.65!important}.hyperarchive .hyper-diagram .accent-wires{stroke-width:.65!important;stroke-linecap:round;stroke-linejoin:round}.hyperarchive .hyper-svg-stars text{fill:var(--hyper-pink)!important;font-size:18px;transform-box:fill-box;transform-origin:center;animation:hyper-twinkle 4s ease-in-out infinite alternate}.hyperarchive .hyper-svg-stars text:nth-child(2){animation-delay:-1.8s}.hyperarchive .hyper-svg-stars text:nth-child(3){animation-delay:-2.7s}@media(prefers-reduced-motion:reduce){.hyperarchive .hyper-svg-stars text{animation:none}}
.hyperarchive .hyper-protocol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px;margin:26px 0 6px;border-top:1px solid var(--hyper-line)}.hyperarchive .hyper-protocol>div{padding:16px 0 18px;border-bottom:1px solid var(--hyper-line)}.hyperarchive .hyper-protocol>div>span{display:block;color:var(--hyper-accent);font:10px/1.5 "Courier New",monospace;letter-spacing:.06em;margin-bottom:9px}.hyperarchive .hyper-protocol p{font-size:12px;line-height:1.7;max-width:49ch;margin:0}.hyperarchive .hyper-protocol>div:nth-child(3n){grid-column:auto}@media(max-width:640px){.hyperarchive .hyper-protocol{grid-template-columns:1fr}}

/* Research atlas — reuse Stellar portfolio's pink italic editorial vocabulary. */
.hyperarchive{--hyper-accent:var(--prose-pink,#ff2bbd);--hyper-line:var(--line,#555);font-family:var(--mono,"Helvetica Neue",Helvetica,Arial,sans-serif);font-size:12px;line-height:1.5}
.hyperarchive .hyper-hero h1{font-family:var(--mono,"Helvetica Neue",Helvetica,Arial,sans-serif);font-size:clamp(32px,5.5vw,92px);letter-spacing:-.065em;line-height:1.03;overflow-wrap:anywhere}
.hyperarchive .hyper-section h2,.hyperarchive .hyper-section h3{font-family:var(--mono,"Helvetica Neue",Helvetica,Arial,sans-serif)}
.hyperarchive .hyper-section h2 em,.hyperarchive .hyper-hero>p,.hyperarchive .hyper-pink-note,.hyperarchive .hyper-loop-return,.hyperarchive .hyper-section p em{font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:400;text-transform:lowercase;color:var(--prose-pink,#ff2bbd)}
.hyperarchive .hyper-hero>p{font-size:clamp(18px,2.5vw,32px);line-height:1.14;max-width:850px}
.hyperarchive .hyper-index,.hyperarchive .hyper-nav,.hyperarchive .hyper-top,.hyperarchive .hyper-diagram figcaption{font-family:var(--mono,"Helvetica Neue",Helvetica,Arial,sans-serif)}
.hyperarchive .hyper-section h2 em{font-size:1.12em}
.hyperarchive .hyper-diagram svg text{font-family:var(--mono,"Helvetica Neue",Helvetica,Arial,sans-serif)}
html[data-portfolio-mode="institutional"] .hyperarchive{--hyper-accent:var(--prose-pink,#ff2bbd)}

/* Stellar research page: brutal grayscale, fluorescent green signals, fuchsia editorial italics. */
.hyperarchive{
 --hyper-accent:var(--signal,#39ff14);--hyper-line:#555;
 color:#dedede;background:transparent;font-family:var(--mono,"Helvetica Neue",Helvetica,Arial,sans-serif);
}
.hyperarchive .hyper-hero h1{
 color:#e8e8e8;font-family:var(--mono,"Helvetica Neue",Helvetica,Arial,sans-serif);
 font-weight:600;letter-spacing:-.075em;
}
.hyperarchive .hyper-accent,
.hyperarchive .hyper-loop-step>span,
.hyperarchive .hyper-steps strong{color:var(--signal,#39ff14)}
 .hyperarchive .hyper-hero-stars{position:absolute;inset:0;display:block;pointer-events:none;z-index:0;color:var(--signal,#39ff14)}
.hyperarchive .hyper-hero-stars span:nth-child(3n){color:#aaa}
.hyperarchive .hyper-hero-stars span:nth-child(4n){color:#ff2bbd}
.hyperarchive .hyper-hero-stars span{animation:hyper-twinkle 3.6s ease-in-out infinite alternate}
.hyperarchive .hyper-hero-stars span:nth-child(2n){animation-delay:-1.4s}
@keyframes hyper-twinkle{to{opacity:.32;transform:scale(.8) rotate(15deg)}}
.hyperarchive .hyper-section h2 em,
.hyperarchive .hyper-hero>p,
.hyperarchive .hyper-pink-note,
.hyperarchive .hyper-loop-return{
 color:var(--prose-pink,#ff2bbd);font-family:Georgia,"Times New Roman",serif;
 font-style:italic;font-weight:400;text-transform:lowercase;
}
.hyperarchive .hyper-hero>p{max-width:900px;font-size:clamp(20px,3vw,42px);line-height:1.15}
.hyperarchive .hyper-diagram{background:#111;border-color:#555}
.hyperarchive .hyper-diagram .nodes{fill:#111;stroke:var(--signal,#39ff14)}
.hyperarchive .hyper-diagram .accent-wires{stroke:var(--signal,#39ff14)}
.hyperarchive .hyper-diagram .hyper-svg-stars text{fill:var(--signal,#39ff14)}
.hyperarchive .hyper-nav a:hover{color:var(--signal,#39ff14)}

/* Astro-scoped selectors must start at the component root, not html. */
.hyperarchive .hyper-section h2 em,.hyperarchive .hyper-pink-note{color:#ff2bbd!important}
.hyperarchive .hyper-diagram .hyper-svg-stars text{fill:#39ff14!important}
.hyperarchive .hyper-previous-links>a,.hyperarchive .hyper-protocol>div>span,.hyperarchive .hyper-genealogy-item>span{font-family:var(--mono,"Helvetica Neue",Helvetica,Arial,sans-serif)}
@media(prefers-reduced-motion:reduce){.hyperarchive .hyper-hero-stars span{animation:none!important}}

/* Related projects — brutal archival halftone cover cards. */
.hyperarchive .hyper-previous-links{gap:12px}
.hyperarchive .hyper-previous-links>a.hyper-project-card{
 display:block;min-height:0;padding:0;overflow:hidden;border:1px solid #626262;
 background:#080808;color:#eee;text-decoration:none;font-family:var(--mono,"Helvetica Neue",Helvetica,Arial,sans-serif)
}
.hyperarchive .hyper-project-cover{
 position:relative;aspect-ratio:4/3;overflow:hidden;background:#171717;
 border-bottom:1px solid #555;isolation:isolate
}
.hyperarchive .hyper-project-cover img{
 display:block;width:100%;height:100%;object-fit:cover;
 filter:grayscale(1) contrast(2.3) brightness(.79);
 transform:scale(1.005);transition:filter .25s steps(4,end),transform .3s steps(5,end);
}
.hyperarchive .hyper-project-cover:after{
 content:"";position:absolute;inset:0;pointer-events:none;
 background:repeating-linear-gradient(0deg,transparent 0 3px,rgba(0,0,0,.32) 3px 4px);
 mix-blend-mode:multiply;opacity:.9
}
.hyperarchive .hyper-cover-cross{
 position:absolute;z-index:2;top:12px;right:14px;color:#39ff14;
 font-size:clamp(22px,4vw,54px);line-height:1;text-shadow:2px 2px #000
}
.hyperarchive .hyper-cover-index{
 position:absolute;z-index:2;bottom:10px;left:10px;
 background:#39ff14;color:#000;font:600 9px/1.2 var(--mono,Helvetica,Arial,sans-serif);
 padding:4px 6px;letter-spacing:.04em
}
.hyperarchive .hyper-cover-fallback{
 display:grid;place-items:center;width:100%;height:100%;font-size:clamp(70px,12vw,190px);
 color:#777;background:repeating-linear-gradient(135deg,#111 0 12px,#292929 12px 13px)
}
.hyperarchive .hyper-project-caption{
 display:grid;grid-template-columns:1fr auto;gap:9px 12px;padding:12px;
 align-items:end;font-family:var(--mono,"Helvetica Neue",Helvetica,Arial,sans-serif)
}
.hyperarchive .hyper-project-caption>span:first-child{grid-column:1/-1;font-size:9px;color:#aaa}
.hyperarchive .hyper-project-caption strong{font-size:clamp(12px,1.4vw,17px);font-weight:600;line-height:1.15;letter-spacing:-.04em}
.hyperarchive .hyper-project-caption>span:last-child{color:#39ff14;font-size:20px;line-height:1}
.hyperarchive .hyper-project-card:hover .hyper-project-cover img,
.hyperarchive .hyper-project-card:focus-visible .hyper-project-cover img{
 filter:grayscale(1) contrast(3) brightness(1.05) sepia(1) hue-rotate(45deg) saturate(5);
 transform:scale(1.055)
}
.hyperarchive .hyper-project-card:hover,.hyperarchive .hyper-project-card:focus-visible{border-color:#39ff14}
@media(prefers-reduced-motion:reduce){.hyperarchive .hyper-project-cover img{transition:none}}

/* Protocol as a full-width editorial strip below each section's main content. */
.hyperarchive .hyper-section>.hyper-protocol{
 grid-column:1/-1;width:100%;max-width:none;margin:8px 0 0;
 display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;
 border-top:1px solid var(--hyper-line);border-bottom:1px solid var(--hyper-line);
}
.hyperarchive .hyper-section>.hyper-protocol>div{
 min-width:0;padding:17px 22px 18px;border-bottom:0;
 border-right:1px solid var(--hyper-line);
}
.hyperarchive .hyper-section>.hyper-protocol>div:first-child{padding-left:0}
.hyperarchive .hyper-section>.hyper-protocol>div:last-child{border-right:0;padding-right:0}
.hyperarchive .hyper-section>.hyper-protocol:has(>div:nth-child(2):last-child){
 grid-template-columns:repeat(2,minmax(0,1fr))
}
.hyperarchive .hyper-section>.hyper-protocol:has(>div:nth-child(4)){
 grid-template-columns:repeat(auto-fit,minmax(200px,1fr))
}
.hyperarchive .hyper-section>.hyper-protocol p{max-width:unset;margin:0}
@media(max-width:700px){
 .hyperarchive .hyper-section>.hyper-protocol,
 .hyperarchive .hyper-section>.hyper-protocol:has(>div:nth-child(2):last-child){
  grid-template-columns:1fr
 }
 .hyperarchive .hyper-section>.hyper-protocol>div,
 .hyperarchive .hyper-section>.hyper-protocol>div:first-child,
 .hyperarchive .hyper-section>.hyper-protocol>div:last-child{
  padding:13px 0;border-right:0;border-bottom:1px solid var(--hyper-line)
 }
 .hyperarchive .hyper-section>.hyper-protocol>div:last-child{border-bottom:0}
}
.hyperarchive .hyper-server-study{margin:24px 0;padding:18px 20px;border:1px solid var(--hyper-line);border-left:3px solid #39ff14;background:rgba(128,128,128,.04)}.hyperarchive .hyper-server-study>span{font:600 10px/1.4 Helvetica,Arial,sans-serif;color:#39ff14}.hyperarchive .hyper-server-study h3{margin:12px 0}.hyperarchive .hyper-server-study small{display:block;margin-top:12px}</style>

