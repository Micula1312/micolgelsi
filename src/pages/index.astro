---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const exhibitions = await getCollection('exhibitions');
const external = await getCollection('external');

const inferResearch = (item) => {
  if (item.data.researchAreas?.length) return item.data.researchAreas;
  const tags = [...(item.data.themes ?? []), ...(item.data.medium ?? [])].map((x) => x.toLowerCase());
  const result = new Set();
  if (tags.some((x) => ['territory', 'ecology', 'wildness', 'urban wilderness'].includes(x))) result.add('urban-wilderness');
  if (tags.some((x) => ['archive', 'research'].includes(x))) result.add('generative-archives');
  if (tags.some((x) => ['interspecies', 'more-than-human'].includes(x))) result.add('interspecies');
  if (tags.some((x) => ['digital', 'net art', 'computer vision', 'interactive installation', 'website', 'interface'].includes(x))) result.add('technology-digitalization');
  if (tags.some((x) => ['memory', 'body', 'participation'].includes(x))) result.add('emotional-geographies');
  return [...result];
};

const normalizeExternalUrl = (value = '') => {
  const url = String(value).trim();
  if (!url) return '';
  if (/^https?:\/\//i.test(url)) return url;
  if (url.startsWith('//')) return `https:${url}`;
  return `https://${url.replace(/^\/+/, '')}`;
};

const normalize = (item) => {
  const year = item.data.year != null ? String(item.data.year) : '—';
  const yearMatch = year.match(/\d{4}/);
  const yearGroup = yearMatch?.[0] ?? year;
  const lane = item.collection === 'external' ? 'external' : 'artistic';
  const start = item.data.startDate ?? yearMatch?.[0] ?? '';
  const end = item.data.endDate ?? (item.data.status === 'ongoing' ? 'ongoing' : yearMatch?.[0] ?? '');
  const externalUrl = item.collection === 'external' ? normalizeExternalUrl(item.data.url) : '';
  return { ...item, yearGroup, lane, start, end, researchAreas: inferResearch(item), href: externalUrl || `/${item.collection}/${item.id}/`, externalLink: Boolean(externalUrl) };
};

const items = [...projects, ...exhibitions, ...external].map(normalize);
const researchAreas = [
  ['urban-wilderness', 'Urban Wilderness'], ['generative-archives', 'Generative Archives'], ['interspecies', 'Interspecies'],
  ['technology-digitalization', 'Technology & Digitalization'], ['emotional-geographies', 'Emotional Geographies'],
  ['eco-feminism', 'Eco-feminism'], ['pleasure-activism', 'Pleasure Activism'], ['body-freedom', 'Body freedom']
];
---
<BaseLayout title="Micol Gelsi">
  <section id="projects" class="work-index" aria-labelledby="projects-heading">
    <div class="index-toolbar"><h1 id="projects-heading">Projects</h1><div class="view-switch" aria-label="Arrange projects by"><button class="view-button is-active" type="button" data-view="year" aria-pressed="true">Year</button><button class="view-button" type="button" data-view="type" aria-pressed="false">Context</button><button class="view-button" type="button" data-view="research" aria-pressed="false">Research</button></div></div>
    <div id="work-list" class="work-list is-year-plane" data-view="year">
      <div class="year-track" data-year-track>
        <div class="year-axis" aria-hidden="true"></div>
        {items.map((item) => (
          <a class={`work-row ${item.lane === 'external' ? 'is-external-project' : ''}`} href={item.href} target={item.externalLink ? '_blank' : undefined} rel={item.externalLink ? 'noopener noreferrer' : undefined} data-year={item.yearGroup} data-type={item.lane} data-title={item.data.title} data-research={item.researchAreas.join(',')} data-start={item.start} data-end={item.end} data-lane={item.lane} data-moments={JSON.stringify(item.data.moments ?? [])} data-avatar={item.data.avatar ?? ''}>
            <span class="timeline-mark" aria-hidden="true"><span class="timeline-end timeline-end-top"></span><span class="timeline-end timeline-end-bottom"></span><span class="output-moments"></span></span><span class="work-title">{item.data.title}{item.externalLink ? ' ↗' : ''}</span>{item.data.collaborators?.length > 0 && <span class="collab-pill">W/ {item.data.collaborators.join(' + ')}</span>}
          </a>
        ))}
      </div>
      <div class="research-field" aria-hidden="true">{researchAreas.map(([key, label]) => <span class={`research-anchor anchor-${key}`}>{label}</span>)}</div>
      <div class="type-field" aria-hidden="true"></div>
    </div>
    <div class="avatar-explosion" data-avatar-explosion aria-hidden="true"><img data-avatar-explosion-image alt="" /></div>
  </section>
  <script is:inline>
    (() => {
      const list=document.querySelector('#work-list');const buttons=[...document.querySelectorAll('.view-button')];if(!list||!buttons.length)return;const rows=[...list.querySelectorAll('.work-row')];const researchField=list.querySelector('.research-field');const typeField=list.querySelector('.type-field');const yearTrack=list.querySelector('[data-year-track]');const yearAxis=list.querySelector('.year-axis');const explosion=document.querySelector('[data-avatar-explosion]');const explosionImage=document.querySelector('[data-avatar-explosion-image]');let hoverRun=0,explosionTimer=null;
      const researchPoints={'urban-wilderness':[12,18],'generative-archives':[43,13],'interspecies':[82,20],'technology-digitalization':[82,72],'emotional-geographies':[43,82],'eco-feminism':[13,72],'pleasure-activism':[22,45]};
      const byTitle=(a,b)=>(a.dataset.title||'').localeCompare(b.dataset.title||'');
      const parseTime=(value,fallback=null)=>{if(!value||value==='—')return fallback;if(value==='ongoing')return Date.now();const raw=String(value);const normalized=/^\d{4}$/.test(raw)?`${raw}-01-01`:/^\d{4}-\d{2}$/.test(raw)?`${raw}-01`:raw;const stamp=Date.parse(normalized);return Number.isFinite(stamp)?stamp:fallback;};
      const clearGenerated=()=>{if(typeField)typeField.innerHTML='';if(yearAxis)yearAxis.innerHTML='';};
      const closeExplosion=()=>{if(explosionTimer)clearTimeout(explosionTimer);explosionTimer=null;explosion?.classList.remove('is-visible');};
      const clearFocus=()=>{hoverRun++;list.classList.remove('has-year-focus');rows.forEach(row=>{row.classList.remove('is-year-focus','is-title-travelling','is-star-hit');const title=row.querySelector('.work-title');title?.getAnimations().forEach(a=>a.cancel());});closeExplosion();};
      const resetRows=()=>rows.forEach(row=>['--x','--y','--top','--height','--left','--width'].forEach(prop=>row.style.removeProperty(prop)));
      const renderMoments=(row)=>{const host=row.querySelector('.output-moments');if(!host)return;host.innerHTML='';let moments=[];try{moments=JSON.parse(row.dataset.moments||'[]')}catch{}if(!moments.length)return;const startStamp=parseTime(row.dataset.start,parseTime(row.dataset.year,Date.now()));const endStamp=parseTime(row.dataset.end,startStamp);const low=Math.min(startStamp,endStamp),high=Math.max(startStamp,endStamp),range=Math.max(1,high-low);moments.forEach(moment=>{const stamp=parseTime(moment.date,startStamp);const chronological=Math.max(0,Math.min(1,(stamp-low)/range));const dot=document.createElement('span');dot.className='moment-dot';dot.style.left=`${chronological*100}%`;const label=document.createElement('span');label.className='moment-label';label.textContent=[moment.date,moment.title,moment.location].filter(Boolean).join(' · ');dot.appendChild(label);host.appendChild(dot);});};
      const explodeAvatar=(row,run)=>{if(run!==hoverRun||!row.matches(':hover'))return;row.classList.add('is-star-hit');const avatar=row.dataset.avatar;if(!avatar||!explosion||!explosionImage)return;explosionImage.src=avatar;explosion.classList.add('is-visible');explosionTimer=setTimeout(()=>explosion.classList.remove('is-visible'),900);};
      const travelTitle=row=>{const title=row.querySelector('.work-title');if(!title)return;const run=++hoverRun;title.getAnimations().forEach(a=>a.cancel());row.classList.add('is-title-travelling');const distance=Math.max(0,row.getBoundingClientRect().width-title.getBoundingClientRect().width*.55);const duration=Math.max(850,Math.min(1800,700+distance*.55));const animation=title.animate([{transform:'translateX(0)'},{transform:`translateX(${distance}px)`}],{duration,easing:'cubic-bezier(.22,.61,.36,1)',fill:'forwards'});animation.finished.then(()=>explodeAvatar(row,run)).catch(()=>{});};
      const focusYearRow=row=>{if(list.dataset.view!=='year')return;rows.forEach(candidate=>candidate.classList.toggle('is-year-focus',candidate===row));list.classList.add('has-year-focus');renderMoments(row);travelTitle(row);};
      rows.forEach(row=>{row.addEventListener('mouseenter',()=>focusYearRow(row));row.addEventListener('mouseleave',clearFocus);row.addEventListener('focus',()=>focusYearRow(row));row.addEventListener('blur',clearFocus);});
      const layoutYear=()=>{if(!yearTrack||!yearAxis)return;rows.forEach(row=>yearTrack.appendChild(row));const now=Date.now();const starts=rows.map(row=>parseTime(row.dataset.start,parseTime(row.dataset.year,now))).filter(Number.isFinite);const ends=rows.map(row=>parseTime(row.dataset.end,parseTime(row.dataset.start,now))).filter(Number.isFinite);const minTime=Math.min(...starts,...ends,now),maxTime=Math.max(...starts,...ends,now),range=Math.max(1,maxTime-minTime);const minYear=new Date(minTime).getFullYear(),maxYear=new Date(maxTime).getFullYear();const yearCount=Math.max(1,maxYear-minYear+1);list.style.setProperty('--year-width',`${Math.max(1500,yearCount*330)}px`);for(let year=minYear;year<=maxYear;year++){const stamp=Date.parse(`${year}-01-01`),left=((stamp-minTime)/range)*100,label=document.createElement('span');label.textContent=String(year);label.style.left=`${Math.max(0,Math.min(100,left))}%`;yearAxis.appendChild(label);}const ordered=[...rows].sort((a,b)=>{const as=parseTime(a.dataset.start,parseTime(a.dataset.year,now)),bs=parseTime(b.dataset.start,parseTime(b.dataset.year,now));return as-bs||byTitle(a,b)});const top=10,bottom=76,lanes=Math.max(1,ordered.length-1);ordered.forEach((row,index)=>{const startStamp=parseTime(row.dataset.start,parseTime(row.dataset.year,now)),endStamp=parseTime(row.dataset.end,startStamp),low=Math.min(startStamp,endStamp),high=Math.max(startStamp,endStamp);const left=3+((low-minTime)/range)*93,width=Math.max(.9,((high-low)/range)*93),y=top+(index/lanes)*(bottom-top);row.style.setProperty('--left',`${left}%`);row.style.setProperty('--width',`${Math.min(96-left,width)}%`);row.style.setProperty('--y',`${y}%`);});requestAnimationFrame(()=>{list.scrollLeft=list.scrollWidth-list.clientWidth;});};
      const layoutType=()=>{rows.forEach(row=>list.appendChild(row));const types=['artistic','external'];const labels={artistic:'Artistic',external:'External'},columnWidth=50;types.forEach((type,typeIndex)=>{if(typeField){const label=document.createElement('span');label.className='type-anchor';label.textContent=labels[type];label.style.left=`${typeIndex*columnWidth+columnWidth/2}%`;typeField.appendChild(label);}rows.filter(row=>(row.dataset.type||'artistic')===type).sort(byTitle).forEach((row,rowIndex)=>{row.style.setProperty('--x',`${typeIndex*columnWidth+columnWidth/2}%`);row.style.setProperty('--y',`${18+rowIndex*9}%`);});});};
      const layoutResearch=()=>{rows.forEach(row=>list.appendChild(row));rows.forEach((row,index)=>{const keys=(row.dataset.research||'').split(',').filter(Boolean),coords=keys.map(key=>researchPoints[key]).filter(Boolean),base=coords.length?coords.reduce((acc,p)=>[acc[0]+p[0],acc[1]+p[1]],[0,0]).map(v=>v/coords.length):[50,50],jitterX=((index*19)%15)-7,jitterY=((index*23)%13)-6;row.style.setProperty('--x',`${Math.max(6,Math.min(92,base[0]+jitterX))}%`);row.style.setProperty('--y',`${Math.max(10,Math.min(90,base[1]+jitterY))}%`);});};
      const setViewportMode=view=>{document.documentElement.dataset.projectView=view;document.body.dataset.projectView=view;};
      list.addEventListener('wheel',e=>{if(list.dataset.view!=='year'||Math.abs(e.deltaY)<=Math.abs(e.deltaX))return;e.preventDefault();list.scrollLeft+=e.deltaY;},{passive:false});
      const layout=(view,animate=true)=>{const first=new Map(rows.map(row=>[row,row.getBoundingClientRect()]));clearFocus();clearGenerated();resetRows();list.classList.toggle('is-year-plane',view==='year');list.classList.toggle('is-type-map',view==='type');list.classList.toggle('is-research-map',view==='research');if(yearTrack)yearTrack.hidden=view!=='year';if(researchField)researchField.hidden=view!=='research';if(typeField)typeField.hidden=view!=='type';if(view==='year')layoutYear();if(view==='type')layoutType();if(view==='research')layoutResearch();list.dataset.view=view;setViewportMode(view);if(!animate||window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;requestAnimationFrame(()=>rows.forEach(row=>{const before=first.get(row),after=row.getBoundingClientRect();if(!before)return;const dx=before.left-after.left,dy=before.top-after.top;if(!dx&&!dy)return;const finalTransform=getComputedStyle(row).transform,fromTransform=finalTransform==='none'?`translate(${dx}px, ${dy}px)`:`translate(${dx}px, ${dy}px) ${finalTransform}`;row.animate([{transform:fromTransform},{transform:finalTransform}],{duration:720,easing:'cubic-bezier(.22,.61,.36,1)'});}));};
      buttons.forEach(button=>button.addEventListener('click',()=>{const view=button.dataset.view;if(!view||list.dataset.view===view)return;buttons.forEach(candidate=>{const active=candidate===button;candidate.classList.toggle('is-active',active);candidate.setAttribute('aria-pressed',String(active));});layout(view);}));layout('year',false);
    })();
  </script>
</BaseLayout>
