---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const exhibitions = await getCollection('exhibitions');
const works = await getCollection('works');
const external = await getCollection('external');

const inferResearch = (item) => {
  if (item.data.researchAreas?.length) return item.data.researchAreas;
  const tags = [...(item.data.themes ?? []), ...(item.data.medium ?? [])].map((x) => x.toLowerCase());
  const result = new Set();
  if (tags.some((x) => ['territory', 'ecology', 'wildness', 'urban wilderness'].includes(x))) result.add('urban-wilderness');
  if (tags.some((x) => ['archive', 'research'].includes(x))) result.add('generative-archives');
  if (tags.some((x) => ['interspecies', 'more-than-human'].includes(x))) result.add('interspecies');
  if (tags.some((x) => ['digital', 'net art', 'computer vision', 'interactive installation', 'website', 'interface'].includes(x))) result.add('technology-digitalization');
  if (tags.some((x) => ['memory', 'body', 'participation'].includes(x))) result.add('emotional-geographies');
  return [...result];
};

const normalize = (item) => {
  const year = item.data.year != null ? String(item.data.year) : '—';
  const yearMatch = year.match(/\d{4}/);
  const yearGroup = yearMatch?.[0] ?? year;
  const typeLabel = item.collection === 'external'
    ? item.data.kind
    : item.data.type === 'exhibition'
      ? 'Exhibition'
      : item.data.medium?.[0] ?? item.data.type;
  const start = item.data.startDate ?? yearMatch?.[0] ?? '';
  const end = item.data.endDate ?? (item.data.status === 'ongoing' ? 'ongoing' : yearMatch?.[0] ?? '');

  return {
    ...item,
    yearGroup,
    typeLabel,
    start,
    end,
    researchAreas: inferResearch(item),
    href: item.collection === 'external' && item.data.url ? item.data.url : `/${item.collection}/${item.id}/`,
    externalLink: item.collection === 'external' && Boolean(item.data.url)
  };
};

const items = [...projects, ...exhibitions, ...works, ...external]
  .map(normalize)
  .sort((a, b) => {
    const aYear = Number(a.yearGroup);
    const bYear = Number(b.yearGroup);
    if (Number.isFinite(aYear) && Number.isFinite(bYear) && aYear !== bYear) return bYear - aYear;
    if (Number.isFinite(aYear) !== Number.isFinite(bYear)) return Number.isFinite(aYear) ? -1 : 1;
    return a.data.title.localeCompare(b.data.title);
  });

const researchAreas = [
  ['urban-wilderness', 'Urban Wilderness'],
  ['generative-archives', 'Generative Archives'],
  ['interspecies', 'Interspecies'],
  ['technology-digitalization', 'Technology & Digitalization'],
  ['emotional-geographies', 'Emotional Geographies']
];
---
<BaseLayout title="Micol Gelsi">
  <section id="projects" class="work-index" aria-labelledby="projects-heading">
    <div class="index-toolbar">
      <h1 id="projects-heading">Projects</h1>
      <div class="view-switch" aria-label="Arrange projects by">
        <button class="view-button is-active" type="button" data-view="year" aria-pressed="true">Year</button>
        <button class="view-button" type="button" data-view="type" aria-pressed="false">Type</button>
        <button class="view-button" type="button" data-view="research" aria-pressed="false">Research</button>
      </div>
    </div>

    <div id="work-list" class="work-list is-year-list" data-view="year">
      <div class="research-field" aria-hidden="true">
        {researchAreas.map(([key, label]) => <span class={`research-anchor anchor-${key}`}>{label}</span>)}
      </div>
      <div class="type-field" aria-hidden="true"></div>

      {items.map((item) => (
        <a
          class={`work-row ${item.collection === 'external' ? 'is-external-project' : ''}`}
          href={item.href}
          target={item.externalLink ? '_blank' : undefined}
          rel={item.externalLink ? 'noreferrer' : undefined}
          data-year={item.yearGroup}
          data-type={item.typeLabel}
          data-title={item.data.title}
          data-research={item.researchAreas.join(',')}
          data-start={item.start}
          data-end={item.end}
        >
          <span class="timeline-mark" aria-hidden="true"><i></i></span>
          <span class="work-title">{item.data.title}{item.externalLink ? ' ↗' : ''}</span>
          {item.data.collaborators?.length > 0 && <span class="collab-pill">W/ {item.data.collaborators.join(' + ')}</span>}
          {item.data.avatar && <img class="project-avatar" src={item.data.avatar} alt="" loading="lazy" />}
        </a>
      ))}
    </div>

    <div class="home-secondary-links" aria-label="Additional sections">
      <a href="/research">Research</a>
      <a href="/playground">Playground</a>
    </div>
  </section>

  <script is:inline>
    (() => {
      const list = document.querySelector('#work-list');
      const buttons = [...document.querySelectorAll('.view-button')];
      if (!list || !buttons.length) return;

      const rows = [...list.querySelectorAll('.work-row')];
      const researchField = list.querySelector('.research-field');
      const typeField = list.querySelector('.type-field');
      const researchPoints = {
        'urban-wilderness': [13, 18],
        'generative-archives': [47, 14],
        'interspecies': [82, 25],
        'technology-digitalization': [75, 78],
        'emotional-geographies': [20, 78]
      };

      const byTitle = (a, b) => (a.dataset.title || '').localeCompare(b.dataset.title || '');
      const sortedByYear = () => [...rows].sort((a, b) => {
        const ay = Number(a.dataset.year);
        const by = Number(b.dataset.year);
        const av = Number.isFinite(ay);
        const bv = Number.isFinite(by);
        if (av && bv && ay !== by) return by - ay;
        if (av !== bv) return av ? -1 : 1;
        return byTitle(a, b);
      });

      const clearGenerated = () => {
        list.querySelectorAll('.work-group').forEach((node) => node.remove());
        if (typeField) typeField.innerHTML = '';
      };

      const resetRows = () => rows.forEach((row) => {
        row.style.removeProperty('--x');
        row.style.removeProperty('--y');
        row.style.removeProperty('--timeline-length');
      });

      const parseYear = (value) => {
        const match = String(value || '').match(/\d{4}/);
        return match ? Number(match[0]) : null;
      };

      const layoutYear = () => {
        let currentYear = null;
        sortedByYear().forEach((row) => {
          const year = row.dataset.year || '—';
          if (year !== currentYear) {
            currentYear = year;
            const heading = document.createElement('div');
            heading.className = 'work-group';
            heading.textContent = year;
            list.appendChild(heading);
          }
          const start = parseYear(row.dataset.start) ?? parseYear(year);
          const end = row.dataset.end === 'ongoing' ? 2026 : (parseYear(row.dataset.end) ?? start);
          const length = start && end ? Math.max(1, end - start + 1) : 1;
          row.style.setProperty('--timeline-length', String(length));
          list.appendChild(row);
        });
      };

      const layoutType = () => {
        const types = [...new Set(rows.map((row) => row.dataset.type || 'Other'))].sort();
        const columnWidth = 100 / Math.max(types.length, 1);
        types.forEach((type, typeIndex) => {
          if (typeField) {
            const label = document.createElement('span');
            label.className = 'type-anchor';
            label.textContent = type;
            label.style.left = `${typeIndex * columnWidth + columnWidth / 2}%`;
            typeField.appendChild(label);
          }
          rows.filter((row) => (row.dataset.type || 'Other') === type)
            .sort(byTitle)
            .forEach((row, rowIndex) => {
              row.style.setProperty('--x', `${typeIndex * columnWidth + columnWidth / 2}%`);
              row.style.setProperty('--y', `${15 + rowIndex * 9}%`);
              list.appendChild(row);
            });
        });
      };

      const layoutResearch = () => {
        rows.forEach((row, index) => {
          const keys = (row.dataset.research || '').split(',').filter(Boolean);
          const coords = keys.map((key) => researchPoints[key]).filter(Boolean);
          const base = coords.length
            ? coords.reduce((acc, point) => [acc[0] + point[0], acc[1] + point[1]], [0, 0]).map((v) => v / coords.length)
            : [50, 50];
          const jitterX = ((index * 19) % 15) - 7;
          const jitterY = ((index * 23) % 13) - 6;
          row.style.setProperty('--x', `${Math.max(6, Math.min(92, base[0] + jitterX))}%`);
          row.style.setProperty('--y', `${Math.max(10, Math.min(90, base[1] + jitterY))}%`);
          list.appendChild(row);
        });
      };

      const layout = (view, animate = true) => {
        const first = new Map(rows.map((row) => [row, row.getBoundingClientRect()]));
        clearGenerated();
        resetRows();
        list.classList.toggle('is-year-list', view === 'year');
        list.classList.toggle('is-type-map', view === 'type');
        list.classList.toggle('is-research-map', view === 'research');
        if (researchField) researchField.hidden = view !== 'research';
        if (typeField) typeField.hidden = view !== 'type';

        if (view === 'year') layoutYear();
        if (view === 'type') layoutType();
        if (view === 'research') layoutResearch();

        list.dataset.view = view;
        if (!animate || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        requestAnimationFrame(() => rows.forEach((row) => {
          const before = first.get(row);
          const after = row.getBoundingClientRect();
          if (!before) return;
          const dx = before.left - after.left;
          const dy = before.top - after.top;
          if (!dx && !dy) return;
          row.animate(
            [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'translate(0,0)' }],
            { duration: 720, easing: 'cubic-bezier(.22,.61,.36,1)' }
          );
        }));
      };

      buttons.forEach((button) => button.addEventListener('click', () => {
        const view = button.dataset.view;
        if (!view || list.dataset.view === view) return;
        buttons.forEach((candidate) => {
          const active = candidate === button;
          candidate.classList.toggle('is-active', active);
          candidate.setAttribute('aria-pressed', String(active));
        });
        layout(view);
      }));

      layout('year', false);
    })();
  </script>
</BaseLayout>
