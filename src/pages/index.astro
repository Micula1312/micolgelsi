import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects=await getCollection('projects');
const exhibitions=await getCollection('exhibitions');
const external=await getCollection('external');
const inferResearch=(item)=>{if(item.data.researchAreas?.length)return item.data.researchAreas;const tags=[...(item.data.themes??[]),...(item.data.medium??[])].map(x=>x.toLowerCase()),result=new Set();if(tags.some(x=>['territory','ecology','wildness','urban wilderness'].includes(x)))result.add('urban-wilderness');if(tags.some(x=>['archive','research'].includes(x)))result.add('generative-archives');if(tags.some(x=>['interspecies','more-than-human'].includes(x)))result.add('interspecies');if(tags.some(x=>['digital','net art','computer vision','interactive installation','website','interface'].includes(x)))result.add('technology-digitalization');if(tags.some(x=>['memory','body','participation'].includes(x)))result.add('emotional-geographies');return[...result];};
const normalizeExternalUrl=(value='')=>{const url=String(value).trim();if(!url)return'';if(/^https?:\/\//i.test(url))return url;if(url.startsWith('//'))return`https:${url}`;return`https://${url.replace(/^\/+/, '')}`;};
const defaultFeatured=new Set(['abundance','archive-of-the-untamed','the-archive-is-alive','untamed-architectureXambient-rave']);
const normalize=(item)=>{const year=item.data.year!=null?String(item.data.year):'—',yearMatch=year.match(/\d{4}/),yearGroup=yearMatch?.[0]??year,lane=item.collection==='external'?'external':'artistic',start=item.data.startDate??yearMatch?.[0]??'',end=item.data.endDate??(item.data.status==='ongoing'?'ongoing':yearMatch?.[0]??''),externalUrl=item.collection==='external'?normalizeExternalUrl(item.data.url):'',featured=Boolean(item.data.featured)||defaultFeatured.has(item.id);return{...item,yearGroup,lane,start,end,featured,researchAreas:inferResearch(item),href:externalUrl||`/${item.collection}/${item.id}/`,externalLink:Boolean(externalUrl)};};
const items=[...projects,...exhibitions,...external].map(normalize);
const researchAreas=[['urban-wilderness','Urban Wilderness'],['generative-archives','Generative Archives'],['interspecies','Interspecies'],['technology-digitalization','Technology & Digitalization'],['emotional-geographies','Emotional Geographies'],['eco-feminism','Eco-feminism'],['pleasure-activism','Pleasure Activism'],['body-freedom','Body freedom']];
---
<BaseLayout title="Micol Gelsi">
<section id="projects" class="work-index" aria-labelledby="projects-heading">
<div class="index-toolbar"><h1 id="projects-heading">Projects</h1><div class="view-switch" aria-label="Arrange projects by"><button class="view-button is-active" type="button" data-view="year" aria-pressed="true">Year</button><button class="view-button" type="button" data-view="type" aria-pressed="false">Context</button><button class="view-button" type="button" data-view="research" aria-pressed="false">Research</button></div></div>
<div id="work-list" class="work-list is-year-plane" data-view="year"><div class="year-track" data-year-track><div class="year-axis" aria-hidden="true"></div>{items.map(item=><a class={`work-row ${item.lane==='external'?'is-external-project':''} ${item.featured?'is-featured':''}`} href={item.href} data-external={item.externalLink?'true':'false'} data-url={item.externalLink?item.href:''} data-year={item.yearGroup} data-type={item.lane} data-title={item.data.title} data-kind={item.collection==='external'?item.data.kind:''} data-practice={item.collection==='external'?(item.data.practice??'web-development'):''} data-role={item.collection==='external'?(item.data.role??'Web development'):''} data-client={item.collection==='external'?(item.data.client??''):''} data-stack={item.collection==='external'?(item.data.stack??[]).join(', '):''} data-summary={item.data.summary??''} data-research={item.researchAreas.join(',')} data-start={item.start} data-end={item.end} data-lane={item.lane} data-moments={JSON.stringify(item.data.moments??[])}><span class="timeline-mark" aria-hidden="true"><span class="timeline-end timeline-end-top"></span><span class="timeline-end timeline-end-bottom"></span><span class="output-moments"></span></span><span class="work-title">{item.data.title}</span>{item.externalLink&&<em class="web-role">web development</em>}<span class="project-badges">{item.data.author&&<span class="author-pill">BY {item.data.author}</span>}</span></a>)}</div><div class="research-field" aria-hidden="true">{researchAreas.map(([key,label])=><span class={`research-anchor anchor-${key}`}>{label}</span>)}</div><div class="type-field" aria-hidden="true"></div></div>
</section>
<div class="web-inspector-backdrop" data-web-backdrop hidden></div><aside class="web-inspector" data-web-inspector aria-hidden="true"><button class="web-inspector-close" type="button" data-web-close aria-label="Close">×</button><div class="web-inspector-kicker">WEB DEVELOPMENT / EXTERNAL PROJECT</div><h2 data-web-title></h2><p class="web-inspector-summary" data-web-summary></p><dl><div data-web-role-row><dt>Role</dt><dd data-web-role></dd></div><div data-web-client-row><dt>Client</dt><dd data-web-client></dd></div><div><dt>Period</dt><dd data-web-period></dd></div><div data-web-stack-row><dt>Stack</dt><dd data-web-stack></dd></div><div data-web-kind-row><dt>Type</dt><dd data-web-kind></dd></div></dl><a class="web-inspector-visit" data-web-visit href="#" target="_blank" rel="noopener noreferrer">VISIT LIVE SITE ↗</a></aside>
<style>
.web-role{display:inline-block;margin-left:7px;font-family:Georgia,'Times New Roman',serif;font-size:10px;font-weight:400;font-style:italic;text-transform:lowercase;color:#ff2bbd;opacity:0;transform:translateY(2px);pointer-events:none}.is-external-project:hover .web-role,.is-external-project:focus-visible .web-role{opacity:1;animation:webBlink 1.05s steps(2,end) infinite}@keyframes webBlink{0%,72%{opacity:1}73%,100%{opacity:.22}}.web-inspector-backdrop{position:fixed;inset:0;z-index:8998;background:rgba(0,0,0,.08);backdrop-filter:blur(1.5px)}.web-inspector{position:fixed;z-index:8999;top:0;right:0;width:min(40vw,560px);height:100dvh;padding:72px 28px 28px;background:var(--bg);border-left:1px solid var(--line);box-shadow:-20px 0 60px rgba(0,0,0,.08);transform:translateX(102%);transition:transform .34s cubic-bezier(.22,.61,.36,1);display:flex;flex-direction:column}.web-inspector.is-open{transform:translateX(0)}.web-inspector-close{position:absolute;top:17px;right:20px;border:0;background:none;color:var(--fg);font:24px/1 var(--mono);cursor:pointer}.web-inspector-kicker{font:9px/1.2 var(--mono);letter-spacing:.08em;color:#ff2bbd;margin-bottom:20px}.web-inspector h2{margin:0 0 18px;font-size:clamp(25px,3vw,46px);line-height:.95;font-weight:500}.web-inspector-summary{max-width:42ch;font-size:13px;line-height:1.45;margin:0 0 34px;color:var(--muted)}.web-inspector dl{margin:0}.web-inspector dl>div{display:grid;grid-template-columns:82px 1fr;gap:12px;padding:8px 0;border-top:1px solid var(--line)}.web-inspector dl>div[hidden]{display:none}.web-inspector dt{font:9px/1.3 var(--mono);text-transform:uppercase;color:var(--muted)}.web-inspector dd{margin:0;font-size:11px}.web-inspector-visit{margin-top:auto;padding-top:18px;border-top:1px solid var(--line);font:11px/1 var(--mono);color:#ff2bbd;text-decoration:none}.web-inspector-visit:hover{font-style:italic}.web-inspector-backdrop[hidden]{display:none}@media(max-width:760px){.web-inspector{width:88vw;padding:64px 18px 20px}.web-role{font-size:9px}}@media(prefers-reduced-motion:reduce){.web-role{animation:none!important}.web-inspector{transition:none}}
</style>
<script is:inline>
(()=>{const list=document.querySelector('#work-list'),buttons=[...document.querySelectorAll('.view-button')];if(!list||!buttons.length)return;const rows=[...list.querySelectorAll('.work-row')],researchField=list.querySelector('.research-field'),typeField=list.querySelector('.type-field'),yearTrack=list.querySelector('[data-year-track]'),yearAxis=list.querySelector('.year-axis');let hoverRun=0,resizeTimer=null;const researchPoints={'urban-wilderness':[12,18],'generative-archives':[43,13],'interspecies':[82,20],'technology-digitalization':[82,72],'emotional-geographies':[43,82],'eco-feminism':[13,72],'pleasure-activism':[22,45]},monthNames=['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'],byTitle=(a,b)=>(a.dataset.title||'').localeCompare(b.dataset.title||''),parseTime=(value,fallback=null)=>{if(!value||value==='—')return fallback;if(value==='ongoing')return Date.now();const raw=String(value),normalized=/^\d{4}$/.test(raw)?`${raw}-01-01`:/^\d{4}-\d{2}$/.test(raw)?`${raw}-01`:raw,stamp=Date.parse(normalized);return Number.isFinite(stamp)?stamp:fallback;};
const inspector=document.querySelector('[data-web-inspector]'),backdrop=document.querySelector('[data-web-backdrop]'),close=document.querySelector('[data-web-close]');const setText=(sel,value,rowSel)=>{const el=inspector?.querySelector(sel),row=rowSel?inspector?.querySelector(rowSel):null;if(el)el.textContent=value||'';if(row)row.hidden=!value;};const closeInspector=()=>{inspector?.classList.remove('is-open');inspector?.setAttribute('aria-hidden','true');if(backdrop)backdrop.hidden=true;};const openInspector=row=>{if(!inspector)return;setText('[data-web-title]',row.dataset.title);setText('[data-web-summary]',row.dataset.summary);setText('[data-web-role]',row.dataset.role,'[data-web-role-row]');setText('[data-web-client]',row.dataset.client,'[data-web-client-row]');setText('[data-web-stack]',row.dataset.stack,'[data-web-stack-row]');setText('[data-web-kind]',row.dataset.kind,'[data-web-kind-row]');setText('[data-web-period]',[row.dataset.start,row.dataset.end].filter(Boolean).join(' — '));const visit=inspector.querySelector('[data-web-visit]');if(visit)visit.href=row.dataset.url;inspector.classList.add('is-open');inspector.setAttribute('aria-hidden','false');if(backdrop)backdrop.hidden=false;close?.focus();};rows.filter(r=>r.dataset.external==='true').forEach(row=>row.addEventListener('click',e=>{e.preventDefault();openInspector(row);}));close?.addEventListener('click',closeInspector);backdrop?.addEventListener('click',closeInspector);document.addEventListener('keydown',e=>{if(e.key==='Escape')closeInspector();});
const clearGenerated=()=>{if(typeField)typeField.innerHTML='';if(yearAxis)yearAxis.innerHTML='';},clearFocus=()=>{hoverRun++;list.classList.remove('has-year-focus');rows.forEach(row=>{row.classList.remove('is-year-focus','is-title-travelling','is-star-hit');row.querySelector('.work-title')?.getAnimations().forEach(a=>a.cancel());});},resetRows=()=>rows.forEach(row=>['--x','--y','--top','--height','--left','--width'].forEach(prop=>row.style.removeProperty(prop))),renderMoments=row=>{const host=row.querySelector('.output-moments');if(!host)return;host.innerHTML='';let moments=[];try{moments=JSON.parse(row.dataset.moments||'[]')}catch{}if(!moments.length)return;const startStamp=parseTime(row.dataset.start,parseTime(row.dataset.year,Date.now())),endStamp=parseTime(row.dataset.end,startStamp),low=Math.min(startStamp,endStamp),high=Math.max(startStamp,endStamp),range=Math.max(1,high-low);moments.forEach(moment=>{const stamp=parseTime(moment.date,startStamp),chronological=Math.max(0,Math.min(1,(stamp-low)/range)),dot=document.createElement('span');dot.className='moment-dot';dot.style.left=`${chronological*100}%`;const label=document.createElement('span');label.className='moment-label';label.textContent=[moment.date,moment.title,moment.location].filter(Boolean).join(' · ');dot.appendChild(label);host.appendChild(dot);});},travelTitle=row=>{const title=row.querySelector('.work-title');if(!title)return;const run=++hoverRun;title.getAnimations().forEach(a=>a.cancel());row.classList.add('is-title-travelling');const distance=Math.max(0,row.getBoundingClientRect().width-title.getBoundingClientRect().width*.55),duration=Math.max(850,Math.min(1800,700+distance*.55)),animation=title.animate([{transform:'translateX(0)'},{transform:`translateX(${distance}px)`}],{duration,easing:'cubic-bezier(.22,.61,.36,1)',fill:'forwards'});animation.finished.then(()=>{if(run===hoverRun&&row.matches(':hover'))row.classList.add('is-star-hit');}).catch(()=>{});},focusYearRow=row=>{if(list.dataset.view!=='year')return;rows.forEach(candidate=>candidate.classList.toggle('is-year-focus',candidate===row));list.classList.add('has-year-focus');renderMoments(row);travelTitle(row);};rows.forEach(row=>{row.addEventListener('mouseenter',()=>focusYearRow(row));row.addEventListener('mouseleave',clearFocus);row.addEventListener('focus',()=>focusYearRow(row));row.addEventListener('blur',clearFocus);});const panelIsVertical=()=>list.clientHeight>list.clientWidth;
const layoutYear=()=>{if(!yearTrack||!yearAxis)return;rows.forEach(row=>yearTrack.appendChild(row));const now=Date.now(),starts=rows.map(row=>parseTime(row.dataset.start,parseTime(row.dataset.year,now))).filter(Number.isFinite),ends=rows.map(row=>parseTime(row.dataset.end,parseTime(row.dataset.start,now))).filter(Number.isFinite),minTime=Math.min(...starts,...ends,now),maxTime=Math.max(...starts,...ends,now),range=Math.max(1,maxTime-minTime),minYear=new Date(minTime).getFullYear(),maxYear=new Date(maxTime).getFullYear(),yearCount=Math.max(1,maxYear-minYear+1),vertical=panelIsVertical(),trackWidth=vertical?Math.max(1500,yearCount*330):Math.max(list.clientWidth+1,960);list.style.setProperty('--year-width',`${trackWidth}px`);list.classList.toggle('is-scrollable-year',trackWidth>list.clientWidth);for(let year=minYear;year<=maxYear;year++){const stamp=Date.parse(`${year}-01-01`),left=((stamp-minTime)/range)*100,label=document.createElement('span');label.className='year-label';label.textContent=String(year);label.style.left=`${Math.max(0,Math.min(100,left))}%`;yearAxis.appendChild(label);for(let month=1;month<12;month++){const monthStamp=Date.parse(`${year}-${String(month+1).padStart(2,'0')}-01`);if(monthStamp<=minTime||monthStamp>=maxTime)continue;const monthLeft=((monthStamp-minTime)/range)*100,monthLabel=document.createElement('span');monthLabel.className='month-label';monthLabel.textContent=monthNames[month];monthLabel.style.left=`${Math.max(0,Math.min(100,monthLeft))}%`;yearAxis.appendChild(monthLabel);}}const ordered=[...rows].sort((a,b)=>{const as=parseTime(a.dataset.start,parseTime(a.dataset.year,now)),bs=parseTime(b.dataset.start,parseTime(b.dataset.year,now));return bs-as||byTitle(a,b)}),top=10,bottom=76,lanes=Math.max(1,ordered.length-1);ordered.forEach((row,index)=>{const startStamp=parseTime(row.dataset.start,parseTime(row.dataset.year,now)),endStamp=parseTime(row.dataset.end,startStamp),low=Math.min(startStamp,endStamp),high=Math.max(startStamp,endStamp),left=3+((low-minTime)/range)*93,width=Math.max(.9,((high-low)/range)*93),y=top+(index/lanes)*(bottom-top);row.style.setProperty('--left',`${left}%`);row.style.setProperty('--width',`${Math.min(96-left,width)}%`);row.style.setProperty('--y',`${y}%`);});requestAnimationFrame(()=>{list.scrollLeft=vertical?list.scrollWidth-list.clientWidth:0;});};
const layoutType=()=>{rows.forEach(row=>list.appendChild(row));const types=['artistic','external'],labels={artistic:'Artistic',external:'Web development'},columnWidth=50;types.forEach((type,typeIndex)=>{if(typeField){const label=document.createElement('span');label.className='type-anchor';label.textContent=labels[type];label.style.left=`${typeIndex*columnWidth+columnWidth/2}%`;typeField.appendChild(label);}rows.filter(row=>(row.dataset.type||'artistic')===type).sort(byTitle).forEach((row,rowIndex)=>{row.style.setProperty('--x',`${typeIndex*columnWidth+columnWidth/2}%`);row.style.setProperty('--y',`${18+rowIndex*9}%`);});});},layoutResearch=()=>{rows.forEach(row=>list.appendChild(row));rows.forEach((row,index)=>{const keys=(row.dataset.research||'').split(',').filter(Boolean),coords=keys.map(key=>researchPoints[key]).filter(Boolean),base=coords.length?coords.reduce((acc,p)=>[acc[0]+p[0],acc[1]+p[1]],[0,0]).map(v=>v/coords.length):[50,50],jitterX=((index*19)%15)-7,jitterY=((index*23)%13)-6;row.style.setProperty('--x',`${Math.max(6,Math.min(92,base[0]+jitterX))}%`);row.style.setProperty('--y',`${Math.max(10,Math.min(90,base[1]+jitterY))}%`);});},setViewportMode=view=>{document.documentElement.dataset.projectView=view;document.body.dataset.projectView=view;};let wheelTarget=list.scrollLeft,wheelFrame=0;
const animateWheel=()=>{const delta=wheelTarget-list.scrollLeft;if(Math.abs(delta)<.5){list.scrollLeft=wheelTarget;wheelFrame=0;return;}list.scrollLeft+=delta*.18;wheelFrame=requestAnimationFrame(animateWheel);};
list.addEventListener('wheel',event=>{if(list.dataset.view!=='year'||!list.classList.contains('is-scrollable-year')||Math.abs(event.deltaY)<=Math.abs(event.deltaX)||list.scrollWidth<=list.clientWidth)return;event.preventDefault();const max=list.scrollWidth-list.clientWidth;wheelTarget=Math.max(0,Math.min(max,wheelTarget+event.deltaY));if(!wheelFrame)wheelFrame=requestAnimationFrame(animateWheel);},{passive:false});
list.addEventListener('scroll',()=>{if(!wheelFrame)wheelTarget=list.scrollLeft;},{passive:true});
/* iOS Safari can lose native momentum inside the fixed dashboard shell. Drive the
   YEAR plane from Pointer Events instead, with a short inertial coast. */
let dragPointer=null,dragStartX=0,dragStartScroll=0,dragLastX=0,dragLastTime=0,dragVelocity=0,dragMoved=false,inertiaFrame=0,suppressClickUntil=0;
const stopInertia=()=>{if(inertiaFrame){cancelAnimationFrame(inertiaFrame);inertiaFrame=0;}};
const coast=()=>{let previous=performance.now();const frame=now=>{const dt=Math.min(32,now-previous);previous=now;list.scrollLeft+=dragVelocity*dt;dragVelocity*=Math.pow(.92,dt/16.67);const max=list.scrollWidth-list.clientWidth;if(list.scrollLeft<=0||list.scrollLeft>=max)dragVelocity*=.45;if(Math.abs(dragVelocity)<.015){inertiaFrame=0;return;}inertiaFrame=requestAnimationFrame(frame);};inertiaFrame=requestAnimationFrame(frame);};
list.addEventListener('pointerdown',event=>{if(list.dataset.view!=='year'||!list.classList.contains('is-scrollable-year')||event.pointerType==='mouse')return;stopInertia();dragPointer=event.pointerId;dragStartX=dragLastX=event.clientX;dragStartScroll=list.scrollLeft;dragLastTime=performance.now();dragVelocity=0;dragMoved=false;list.classList.add('is-dragging-year');list.setPointerCapture?.(event.pointerId);});
list.addEventListener('pointermove',event=>{if(event.pointerId!==dragPointer)return;const now=performance.now(),dx=event.clientX-dragStartX,next=dragStartScroll-dx,dt=Math.max(1,now-dragLastTime),instant=(dragLastX-event.clientX)/dt;if(Math.abs(dx)>4)dragMoved=true;list.scrollLeft=next;dragVelocity=dragVelocity*.68+instant*.32;dragLastX=event.clientX;dragLastTime=now;});
const endDrag=event=>{if(event.pointerId!==dragPointer)return;if(dragMoved){suppressClickUntil=performance.now()+350;coast();}list.classList.remove('is-dragging-year');try{list.releasePointerCapture?.(event.pointerId)}catch{}dragPointer=null;};
list.addEventListener('pointerup',endDrag);
list.addEventListener('pointercancel',endDrag);
list.addEventListener('click',event=>{if(performance.now()<suppressClickUntil){event.preventDefault();event.stopPropagation();}},true);
const layout=(view,animate=true)=>{const first=new Map(rows.map(row=>[row,row.getBoundingClientRect()]));closeInspector();clearFocus();clearGenerated();resetRows();list.classList.toggle('is-year-plane',view==='year');list.classList.toggle('is-type-map',view==='type');list.classList.toggle('is-research-map',view==='research');if(view!=='year')list.classList.remove('is-scrollable-year');if(yearTrack)yearTrack.hidden=view!=='year';if(researchField)researchField.hidden=view!=='research';if(typeField)typeField.hidden=view!=='type';if(view==='year')layoutYear();if(view==='type')layoutType();if(view==='research')layoutResearch();list.dataset.view=view;setViewportMode(view);if(!animate||window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;requestAnimationFrame(()=>rows.forEach(row=>{const before=first.get(row),after=row.getBoundingClientRect();if(!before)return;const dx=before.left-after.left,dy=before.top-after.top;if(!dx&&!dy)return;const finalTransform=getComputedStyle(row).transform,fromTransform=finalTransform==='none'?`translate(${dx}px, ${dy}px)`:`translate(${dx}px, ${dy}px) ${finalTransform}`;row.animate([{transform:fromTransform},{transform:finalTransform}],{duration:720,easing:'cubic-bezier(.22,.61,.36,1)'});}));};window.addEventListener('resize',()=>{if(list.dataset.view!=='year')return;clearTimeout(resizeTimer);resizeTimer=setTimeout(()=>{clearGenerated();layoutYear();},120);});buttons.forEach(button=>button.addEventListener('click',()=>{const view=button.dataset.view;if(!view||list.dataset.view===view)return;buttons.forEach(candidate=>{const active=candidate===button;candidate.classList.toggle('is-active',active);candidate.setAttribute('aria-pressed',String(active));});layout(view);}));layout('year',false);})();
</script>
<script is:inline>
(() => {
  /* iOS changes the viewport height while its browser bars move. Do not let those
     height-only resize events rebuild the YEAR plane and reset horizontal scroll. */
  let stableViewportWidth = window.innerWidth;
  window.addEventListener('resize', event => {
    const widthChanged = Math.abs(window.innerWidth - stableViewportWidth) > 1;
    if (!widthChanged) event.stopImmediatePropagation();
    else stableViewportWidth = window.innerWidth;
  }, true);
})();
</script>
</BaseLayout>
