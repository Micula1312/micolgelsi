---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About — Micol Gelsi">
  <section class="simple-index about-page">
    <h1>About</h1>

    <div class="prose about-copy">
      <p>Micol Gelsi is an artist and researcher working across performative and multimedia arts.</p>
      <p>Her practice moves between physical and virtual spaces, approaching archives, bodies, territories and digital systems as unstable and relational structures.</p>
      <p>Memory, liminality, power and more-than-human relations recur as fields of investigation. Net art, architecture, moving image, sound and interactive technologies become tools for situated research and collective imagination.</p>
      <p>This page is intentionally concise for now: it will become the longer biographical and practice statement used across applications, portfolios and printed material.</p>
    </div>

    <section id="contact" class="related about-contact">
      <h2>Contact</h2>
      <div class="index">
        <div class="index-row"><span class="index-number">01</span><span class="index-title">Email</span><span></span><span class="index-year">add email</span></div>
        <div class="index-row"><span class="index-number">02</span><span class="index-title">Instagram</span><span></span><span class="index-year">add link</span></div>
      </div>
    </section>
  </section>
</BaseLayout>
