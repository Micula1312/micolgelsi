---
import BaseLayout from '../layouts/BaseLayout.astro';
import homeConfig from '../../config/home.json';
const base = import.meta.env.BASE_URL;
const photo = (homeConfig.aboutPhoto || '').trim();
const photoSrc = photo ? (/^https?:\/\//.test(photo) ? photo : base + photo.replace(/^\/+/, '')) : '';
---
<BaseLayout title="About — Micol Gelsi">
  <section class="about-page" aria-labelledby="about-title">
    <div class="about-heading">
      <span>01 / ABOUT</span>
      <a href={base}>← INDEX</a>
    </div>
    <div class="about-layout">
      <div class="about-copy">
        <h1 id="about-title">Micol Gelsi</h1>
        <p class="about-role">Artist, researcher & creative coder</p>
        {homeConfig.bio.map(line => <p>{line}</p>)}
        <nav class="about-links" aria-label="Further information">
          <a href={base + 'cv/'}>CV ↗</a>
          <a href={base + 'play-with-me/'}>CONTACT ↗</a>
        </nav>
      </div>
      <figure class="about-portrait">
        {photoSrc ? <img src={photoSrc} alt="Portrait of Micol Gelsi" loading="eager" /> : <div class="about-photo-placeholder" aria-label="Portrait photograph to be added"><span>PORTRAIT / COMING SOON</span></div>}
      </figure>
    </div>
  </section>
</BaseLayout>
<style>
  .about-page{width:min(100%,1320px);margin:0 auto;padding:clamp(20px,4vw,60px) 0 90px;color:var(--fg)}
  .about-heading{display:flex;justify-content:space-between;gap:16px;padding:0 0 18px;border-bottom:1px solid currentColor;font:11px/1.4 Arial,Helvetica,sans-serif;letter-spacing:.06em}
  .about-heading a{text-decoration:none}
  .about-layout{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(260px,.8fr);gap:clamp(30px,7vw,120px);padding-top:clamp(28px,5vw,72px);align-items:start}
  .about-copy h1{font:normal clamp(42px,6vw,96px)/1.05 Georgia,serif;letter-spacing:-.04em;margin:0 0 12px}
  .about-role{font:11px/1.4 Arial,Helvetica,sans-serif;text-transform:uppercase;letter-spacing:.08em;margin:0 0 54px!important}
  .about-copy>p:not(.about-role){font:normal clamp(17px,1.7vw,23px)/1.55 Georgia,serif;max-width:36em;margin:0 0 22px}
  .about-portrait{margin:0}
  .about-portrait img{display:block;width:100%;height:auto;object-fit:contain}
  .about-photo-placeholder{aspect-ratio:3/4;border:1px solid currentColor;display:flex;align-items:center;justify-content:center;opacity:.5;font:10px Arial,Helvetica,sans-serif;letter-spacing:.1em}
  .about-links{display:flex;gap:28px;margin-top:56px;font:12px Arial,Helvetica,sans-serif}
  @media(max-width:760px){.about-layout{grid-template-columns:1fr}.about-portrait{grid-row:1;max-width:440px}.about-role{margin-bottom:30px!important}}
</style>
