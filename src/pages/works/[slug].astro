---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TeaserEmbed from '../../components/TeaserEmbed.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){const works=await getCollection('works');return works.map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content}=await render(entry);const parent=entry.data.parent;const typeLabel=entry.data.displayType;
---
<BaseLayout title={`${entry.data.title} — Micol Gelsi`}>
  <div class="eyebrow">{parent?<a href={`/${parent.type==='exhibition'?'exhibitions':'projects'}/${parent.slug}/`}>← {parent.slug.replaceAll('-',' ')}</a>:'Work'}</div>
  <section class="intro"><h1>{entry.data.title}</h1>{entry.data.summary&&<p class="lead">{entry.data.summary}</p>}</section>
  {entry.data.teaser?<TeaserEmbed url={entry.data.teaser} title={`${entry.data.title} — teaser`} />:entry.data.cover&&<figure class="project-cover"><img src={entry.data.cover} alt="" /></figure>}
  <div class="project-body"><article class="prose"><Content /></article><aside class="project-facts">
    {entry.data.author&&<div><span>Author</span>{entry.data.author}</div>}
    {typeLabel&&<div><span>Type</span>{typeLabel}</div>}
    {entry.data.startDate&&<div><span>Start</span>{entry.data.startDate}</div>}
    {entry.data.endDate&&<div><span>End</span>{entry.data.endDate}</div>}
    {entry.data.status&&<div><span>Status</span>{entry.data.status}</div>}
    {entry.data.medium.length>0&&<div><span>Medium</span>{entry.data.medium.join(', ')}</div>}
    {entry.data.researchAreas.length>0&&<div><span>Research</span>{entry.data.researchAreas.join(', ')}</div>}
    {entry.data.collaborators.length>0&&<div><span>Collaborators</span>{entry.data.collaborators.join(', ')}</div>}
    {entry.data.artistsInvolved.length>0&&<div><span>Artists involved</span>{entry.data.artistsInvolved.join(', ')}</div>}
    {entry.data.curatedBy.length>0&&<div><span>Curated by</span>{entry.data.curatedBy.join(', ')}</div>}
    {entry.data.credits.length>0&&<div><span>Credits</span>{entry.data.credits.join(', ')}</div>}
    {entry.data.photoCredits.length>0&&<div><span>Photo credits</span>{entry.data.photoCredits.join(', ')}</div>}
  </aside></div>
  {entry.data.gallery.length>0&&<section class="media-grid">{entry.data.gallery.map((src,i)=><figure><img src={src} alt={`${entry.data.title} — ${i+1}`} loading="lazy" /></figure>)}</section>}
  {entry.data.videos.length>0&&<section class="video-list">{entry.data.videos.map(src=><video src={src} controls playsinline preload="metadata"></video>)}</section>}
  {entry.data.links.length>0&&<section class="project-links"><h2>Links</h2>{entry.data.links.map(link=><a href={link} target="_blank" rel="noreferrer">{link} ↗</a>)}</section>}
  <style>.project-facts{font-size:11px;line-height:1.28}.project-facts>div{display:grid;grid-template-columns:minmax(72px,.75fr) minmax(0,1.6fr);gap:12px;padding:6px 0;border-top:1px solid var(--line)}.project-facts>div:last-child{border-bottom:1px solid var(--line)}.project-facts span{font-family:var(--mono);font-size:9px;line-height:1.2;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}@media(max-width:760px){.project-facts{font-size:10px}.project-facts>div{grid-template-columns:82px minmax(0,1fr);gap:8px}.project-facts span{font-size:8px}}</style>
</BaseLayout>
