---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="WRITE — SBRD DIARY">
<section class="writer">
<header><a href="/portfolio/diary/">← SBRD DIARY</a><span id="network">CHECKING CONNECTION</span></header>
<h1>★ NEW SBRD</h1>
<form id="editor">
<label>DATE <input id="date" type="date" required /></label>
<label>TITLE / OPTIONAL <input id="title" autocomplete="off" placeholder="Untitled" /></label>
<label>NOTE <textarea id="body" rows="9" placeholder="Write anything…" required></textarea></label>
<label>KEYWORDS <input id="keywords" placeholder="archive, city, references" /></label>
<label>REFERENCE URL <input id="url" type="url" placeholder="https://" /></label>
<label>WHY KEEP IT? <textarea id="referenceNote" rows="2"></textarea></label>
<label>PHOTOS <input id="photos" type="file" accept="image/*" multiple /></label>
<div id="attachments"></div>
<div class="actions"><button type="button" id="draft">SAVE DRAFT</button><button type="button" id="publish">QUEUE TO PUBLISH ↗</button></div>
</form>
<div class="notice" id="status" role="status">Local-first diary. Your notes stay on this device until you publish.</div>
<h2>LOCAL ENTRIES <span id="count"></span></h2><div id="entries"></div>
</section>
<style>
.writer{max-width:820px;margin:auto;padding:90px 18px 120px;font:12px/1.4 var(--mono)}.writer header{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line);padding-bottom:12px}.writer a{color:inherit}.writer h1{font:800 clamp(32px,7vw,72px)/.9 var(--mono);letter-spacing:-.06em;margin:35px 0}.writer form{display:grid;gap:17px}.writer label{display:grid;gap:6px;font:10px var(--mono)}.writer input,.writer textarea{width:100%;box-sizing:border-box;background:transparent;border:1px solid var(--line);color:var(--fg);border-radius:0;padding:12px;font:16px/1.4 var(--mono)}.writer textarea{resize:vertical}.actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.writer button{cursor:pointer;padding:14px 8px;background:transparent;color:var(--fg);border:1px solid var(--line);font:11px var(--mono)}#publish{background:#39ff14;color:#050505;border-color:#39ff14}.notice{margin:18px 0 42px;font:italic 14px Georgia,serif;color:#ff2bbd}.writer h2{font:800 16px var(--mono);border-bottom:1px solid var(--line);padding-bottom:12px}.entry{border-bottom:1px solid var(--line);padding:15px 0;display:grid;gap:6px}.entry small{color:var(--muted)}.entry .buttons{display:flex;gap:6px}.entry button{padding:6px 10px;font-size:10px}#attachments{display:flex;gap:8px;flex-wrap:wrap}#attachments img{width:76px;height:76px;object-fit:cover}@media(max-width:600px){.actions{grid-template-columns:1fr}.writer{padding-top:75px}}
</style>
<script is:inline>
(()=>{
const $=id=>document.getElementById(id),dbName='sbrd-diary-local',store='entries';let currentId=null,photoBlobs=[];
const open=()=>new Promise((resolve,reject)=>{const req=indexedDB.open(dbName,1);req.onupgradeneeded=()=>req.result.createObjectStore(store,{keyPath:'id'});req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error)});
const tx=async(mode,fn)=>{const db=await open();return new Promise((resolve,reject)=>{const t=db.transaction(store,mode),s=t.objectStore(store),r=fn(s);r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error);t.oncomplete=()=>db.close()})};
const all=()=>tx('readonly',s=>s.getAll());const put=v=>tx('readwrite',s=>s.put(v));const del=id=>tx('readwrite',s=>s.delete(id));
const status=message=>$('status').textContent=message;
const updateNetwork=()=>{$('network').textContent=navigator.onLine?'● ONLINE':'○ OFFLINE'};
window.addEventListener('online',()=>{updateNetwork();status('Connection restored. Pending posts remain safely queued until secure GitHub sync is configured.')});window.addEventListener('offline',updateNetwork);updateNetwork();
$('date').value=new Date().toLocaleDateString('en-CA');
const previews=()=>{const host=$('attachments');host.replaceChildren();photoBlobs.forEach(file=>{const img=document.createElement('img');const u=URL.createObjectURL(file);img.src=u;img.onload=()=>URL.revokeObjectURL(u);host.append(img)})};
$('photos').onchange=e=>{photoBlobs.push(...[...e.target.files].filter(f=>f.type.startsWith('image/')));previews()};
const save=async queued=>{const body=$('body').value.trim();if(!body){status('Write a note first.');return}const id=currentId||crypto.randomUUID();const record={id,date:$('date').value,title:$('title').value.trim(),text:body,keywords:$('keywords').value.split(',').map(s=>s.trim()).filter(Boolean),links:$('url').value.trim()?[{url:$('url').value.trim(),label:'',note:$('referenceNote').value.trim()}]:[],photos:photoBlobs,status:queued?'queued':'draft',updatedAt:new Date().toISOString()};try{await put(record);currentId=null;photoBlobs=[];$('editor').reset();$('date').value=new Date().toLocaleDateString('en-CA');previews();status(queued?'Saved to publishing queue on this device. GitHub sync is not yet connected.':'Draft saved privately on this device.');await render()}catch(e){status('Could not save locally: '+e.message)}};
$('draft').onclick=()=>save(false);$('publish').onclick=()=>save(true);
async function render(){const items=(await all()).sort((a,b)=>b.updatedAt.localeCompare(a.updatedAt));$('count').textContent=items.length;const host=$('entries');host.replaceChildren();items.forEach(item=>{const div=document.createElement('div');div.className='entry';const name=document.createElement('strong');name.textContent=item.title||item.text.slice(0,80);const meta=document.createElement('small');meta.textContent=item.date+' · '+item.status.toUpperCase()+' · '+item.photos.length+' PHOTO(S)';const buttons=document.createElement('div');buttons.className='buttons';const edit=document.createElement('button');edit.textContent='EDIT';edit.onclick=()=>{currentId=item.id;$('date').value=item.date;$('title').value=item.title;$('body').value=item.text;$('keywords').value=item.keywords.join(', ');$('url').value=item.links[0]?.url||'';$('referenceNote').value=item.links[0]?.note||'';photoBlobs=item.photos||[];previews();window.scrollTo({top:0,behavior:'smooth'})};const remove=document.createElement('button');remove.textContent='DELETE';remove.onclick=async()=>{if(confirm('Delete local entry?')){await del(item.id);render()}};buttons.append(edit,remove);div.append(name,meta,buttons);host.append(div)})}
render().catch(e=>status('Local storage unavailable: '+e.message));
if('serviceWorker' in navigator)navigator.serviceWorker.register('/portfolio/sbrd-sw.js',{scope:'/portfolio/'}).catch(()=>{});
})();
</script>
</BaseLayout>
