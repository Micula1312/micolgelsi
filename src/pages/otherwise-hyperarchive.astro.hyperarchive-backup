import BaseLayout from '../layouts/BaseLayout.astro';
import hyperNotes from '../data/hyperarchive-notes.json';
import fs from 'node:fs';
import path from 'node:path';
const mediaRoot=path.join(process.cwd(),'public','media','artistic');
function projectCover(slug){
  const dir=path.join(mediaRoot,slug);
  if(!fs.existsSync(dir))return null;
  const infoPath=path.join(process.cwd(),'src','projects','artistic',slug,'info.txt');
  const info=fs.existsSync(infoPath)?fs.readFileSync(infoPath,'utf8'):'';
  const specified=info.match(/^COVER:\s*(.+)$/m)?.[1]?.trim();
  const files=[];
  function walk(folder,depth=0){
    if(depth>3)return;
    for(const item of fs.readdirSync(folder,{withFileTypes:true})){
      if(item.name.startsWith('.')||/^(source|sources|backup|originals)$/i.test(item.name))continue;
      const full=path.join(folder,item.name);
      if(item.isDirectory())walk(full,depth+1);
      else if(/\.(jpe?g|png|webp|avif|gif)$/i.test(item.name))files.push(path.relative(dir,full).replaceAll('\\','/'));
    }
  }
  walk(dir);
  files.sort((a,b)=>a.localeCompare(b,undefined,{numeric:true}));
  const selected=files.find(x=>x===specified||x.split('/').at(-1)===specified)
    ||files.find(x=>/^(cover|poster|thumbnail|hero)([._-]|$)/i.test(x.split('/').at(-1)))
    ||files.find(x=>/^(avatar)([._-]|$)/i.test(x.split('/').at(-1)))
    ||files[0];
  return selected?import.meta.env.BASE_URL+'media/artistic/'+slug+'/'+selected.split('/').map(encodeURIComponent).join('/'):null;
}
const untamedCover=projectCover('archive-of-the-untamed');
const aliveCover=projectCover('the-archive-is-alive');
const base = import.meta.env.BASE_URL;
// Add future calls here; the atlas remains a single canonical page.
const applications = [
  { programme: 'EMAP', type: 'ARTIST RESIDENCY', year: '2027', status: 'ongoing', label: 'APPLICATION ONGOING', url: null },
];
