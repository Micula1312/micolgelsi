---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Playground — Micol Gelsi">
  <section class="board" aria-labelledby="playground-title">
    <div class="board-toolbar">
      <h1 id="playground-title">PLAYGROUND</h1>
      <span class="board-meta">machines / leftovers / interfaces / tests</span>
      <button type="button" data-random>★ RANDOM</button>
    </div>

    <div class="board-grid" data-grid>
      <a class="panel panel-wide" href="https://thearchiveoftheuntamed.xyz/" target="_blank" rel="noreferrer">
        <span class="panel-index">001 / LIVE</span>
        <strong>ARCHIVE OF THE #UNTAMED ↗</strong>
        <span class="panel-note">living archive / interface</span>
      </a>

      <a class="panel" href="/play-with-me">
        <span class="panel-index">002 / PLAY</span>
        <strong>DRAW ON YOURSELF →</strong>
        <span class="panel-note">camera / canvas / body</span>
      </a>

      <button class="panel panel-button" type="button" data-shuffle>
        <span class="panel-index">003 / USELESS</span>
        <strong>REARRANGE NOTHING</strong>
        <span class="panel-note">a machine with no consequence</span>
      </button>

      <div class="panel panel-quiet" aria-hidden="true">
        <span class="panel-index">004 / FRAGMENT</span>
        <strong>the archive is wet ★</strong>
        <span class="glyph-fragment">⣎⡇ꉺლ༽இ•̛)ྀ◞ ༎ຶ</span>
      </div>

      <div class="panel panel-empty" aria-hidden="true">
        <span class="panel-index">005 / EMPTY SLOT</span>
        <span class="cross">+</span>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const links = [...document.querySelectorAll('.board-grid a.panel')];
      const random = document.querySelector('[data-random]');
      const shuffle = document.querySelector('[data-shuffle]');
      const pulse = (el) => {
        if (!el) return;
        el.animate([{opacity:1},{opacity:.18},{opacity:1},{opacity:.36},{opacity:1}], {duration:620,easing:'steps(1,end)'});
      };
      random?.addEventListener('click', () => {
        const target = links[Math.floor(Math.random() * links.length)];
        if (!target) return;
        pulse(target);
        setTimeout(() => target.target === '_blank' ? window.open(target.href, '_blank', 'noopener') : location.href = target.href, 650);
      });
      shuffle?.addEventListener('click', () => pulse(shuffle));
    })();
  </script>

  <style>
    .board{height:100%;min-height:0;border:1px solid var(--line);padding:12px;display:grid;grid-template-rows:auto minmax(0,1fr);overflow:hidden}
    .board-toolbar{display:grid;grid-template-columns:auto 1fr auto;gap:24px;align-items:baseline;min-height:36px;font-family:var(--mono);font-size:11px}
    .board-toolbar h1{font-weight:700}.board-meta{color:var(--muted)}.board-toolbar button{border:0;background:none;padding:0;cursor:pointer;font:inherit;font-weight:700}
    .board-grid{min-height:0;border:1px solid var(--line);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:repeat(2,minmax(0,1fr));overflow:hidden}
    .panel{position:relative;min-width:0;min-height:0;padding:11px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;flex-direction:column;justify-content:space-between;gap:12px;color:inherit;background:none;text-align:left;overflow:hidden}
    .panel:nth-child(3),.panel:nth-child(5){border-right:0}.panel:nth-child(n+4){border-bottom:0}.panel-wide{grid-column:span 2}.panel-button{font:inherit;cursor:pointer}.panel:hover{background:color-mix(in srgb,var(--fg) 3%,transparent)}
    .panel-index,.panel-note{font-family:var(--mono);font-size:10px;color:var(--muted);font-weight:400}.panel strong{max-width:32ch;font-size:clamp(13px,1.25vw,18px);line-height:1.05;text-transform:uppercase}.glyph-fragment{font-size:clamp(18px,3vw,44px);line-height:1;color:var(--muted);white-space:nowrap}.panel-empty{justify-content:flex-start}.cross{margin:auto;font-size:clamp(30px,5vw,70px);font-weight:200;color:var(--muted)}
    @media(max-width:760px){.board{padding:8px}.board-toolbar{grid-template-columns:1fr auto;gap:8px 14px;min-height:48px}.board-meta{grid-column:1/-1;grid-row:2}.board-grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(3,minmax(0,1fr))}.panel-wide{grid-column:span 2}.panel{padding:8px;border-right:1px solid var(--line)!important;border-bottom:1px solid var(--line)!important}.panel:nth-child(2n+1):not(.panel-wide){border-right:0!important}.panel:last-child{border-bottom:0!important}.panel-index,.panel-note{font-size:9px}.glyph-fragment{font-size:18px}}
  </style>
</BaseLayout>
