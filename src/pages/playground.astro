---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Playground — Micol Gelsi">
  <section class="playground-board">
    <header class="playground-head">
      <div>
        <small>PLAYGROUND / OPEN FIELD</small>
        <h1 class="glyph" data-glyph="⣎⡇ꉺლ༽இ•̛)ྀ◞">PLAYGROUND</h1>
      </div>
      <button type="button" data-random>★ RANDOM</button>
    </header>

    <div class="field" data-field>
      <a class="toy glyph" href="https://thearchiveoftheuntamed.xyz/" target="_blank" rel="noreferrer" data-glyph="☻︎✦︎⌁︎✺︎☞︎">ARCHIVE OF THE #UNTAMED ↗</a>
      <button class="toy glyph" type="button" data-worse data-glyph="☁︎♒︎☄︎⌁︎✹︎☻︎">MAKE THIS PAGE WORSE</button>
      <span class="toy fragment">the archive is wet ★</span>
      <span class="toy fragment huge">⣎⡇ꉺლ༽இ•̛)ྀ◞ ༎ຶ</span>
      <span class="toy fragment">[ USELESS MACHINE ]</span>
      <span class="toy fragment">???</span>
    </div>
  </section>

  <script is:inline>
    (() => {
      const toys = [...document.querySelectorAll('.toy')];
      const place = () => toys.forEach((toy, i) => {
        const s = Date.now() / 4200 + i * 11.7;
        toy.style.left = `${5 + ((Math.sin(s * 1.17) + 1) / 2) * 80}%`;
        toy.style.top = `${8 + ((Math.cos(s * 1.61) + 1) / 2) * 76}%`;
        toy.style.transform = `rotate(${-4 + ((Math.sin(s * .83) + 1) / 2) * 8}deg)`;
      });
      place();
      document.querySelector('[data-worse]')?.addEventListener('click', place);
      document.querySelector('[data-random]')?.addEventListener('click', () => {
        const links = [...document.querySelectorAll('.toy[href]')];
        const link = links[Math.floor(Math.random() * links.length)];
        if (link) window.open(link.href, link.target || '_self', 'noopener');
      });
    })();
  </script>

  <style>
    .playground-board{height:calc(100svh - 202px);min-height:520px;border:1px solid var(--line);padding:12px;overflow:hidden}.playground-head{display:flex;justify-content:space-between;gap:24px;align-items:end}.playground-head small{color:var(--muted);font-family:var(--mono);font-size:11px}.playground-head h1{margin-top:4px;font-size:clamp(28px,4vw,64px);font-weight:700}.playground-head button{border:0;background:none;font:inherit;font-weight:700;cursor:pointer}.field{position:relative;height:calc(100% - 82px);margin-top:14px;border:1px solid var(--line);overflow:hidden}.toy{position:absolute;width:max-content;max-width:260px;padding:7px 9px;border:1px solid var(--line);background:color-mix(in srgb,var(--bg) 92%,transparent);font:inherit;color:inherit;cursor:pointer}.toy:hover{z-index:9;text-decoration:none;box-shadow:0 0 10px var(--signal-soft),0 0 25px var(--signal-faint)}.fragment{border:0;background:transparent;color:var(--muted);pointer-events:none}.huge{font-size:clamp(20px,3vw,42px)}.glyph{position:relative;display:inline-block}.glyph:hover{color:transparent!important;text-shadow:none!important;text-decoration:none!important}.glyph:hover::after{content:attr(data-glyph);position:absolute;left:0;top:0;width:max-content;max-width:100%;overflow:hidden;color:var(--signal);font-family:"Segoe UI Symbol","Segoe UI Emoji","Apple Symbols",sans-serif;font-weight:400;letter-spacing:.06em;text-shadow:0 0 6px var(--signal-soft),0 0 14px var(--signal-faint)}
    @media(max-width:760px){.playground-board{height:72svh;min-height:620px}.toy{max-width:160px;font-size:11px}}
  </style>
</BaseLayout>
