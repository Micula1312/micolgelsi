---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TeaserEmbed from '../../components/TeaserEmbed.astro';
import MomentGallery from '../../components/MomentGallery.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){const projects=await getCollection('projects');return projects.map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content}=await render(entry);const allWorks=await getCollection('works');const relatedWorks=allWorks.filter(work=>entry.data.works.includes(work.id)||work.data.parent?.slug===entry.id);const worksByTitle=new Map(relatedWorks.map(work=>[work.data.title.toLowerCase(),work]));const typeLabel=entry.data.displayType;const loaderImage=entry.data.avatar||entry.data.cover||entry.data.gallery?.[0]||'';const loaderIsVideo=/\.(?:mp4|webm|mov)(?:$|\?)/i.test(loaderImage);
---
<BaseLayout title={`${entry.data.title} — Micol Gelsi`}>
  {loaderImage&&<div class="project-entry-loader" data-project-loader aria-hidden="true">{loaderIsVideo?<video src={loaderImage} autoplay muted loop playsinline preload="auto"></video>:<img src={loaderImage} alt="" />}<div class="project-entry-signal"><span>{entry.data.title}</span><span>{entry.data.avatar?'avatar / loading':'loading / enter'}</span></div></div>}
  <div class="eyebrow"><a href="/#projects">Projects</a>{typeLabel&&<> · <span>{typeLabel}</span></>}{entry.data.year&&<> · <span>{entry.data.year}</span></>}</div>
  <section class="project-head"><h1>{entry.data.title}</h1>{entry.data.summary&&<p class="lead">{entry.data.summary}</p>}</section>
  {entry.data.teaser?<TeaserEmbed url={entry.data.teaser} title={`${entry.data.title} — teaser`} />:entry.data.cover&&<figure class="project-cover"><img src={entry.data.cover} alt="" /></figure>}
  <div class="project-body">
    <article class="prose"><Content /></article>
    <aside class="project-facts">
      {entry.data.author&&<div><span>Author</span>{entry.data.author}</div>}{typeLabel&&<div><span>Type</span>{typeLabel}</div>}{entry.data.startDate&&<div><span>Start</span>{entry.data.startDate}</div>}{entry.data.endDate&&<div><span>End</span>{entry.data.endDate}</div>}{entry.data.status&&<div><span>Status</span>{entry.data.status}</div>}{entry.data.medium.length>0&&<div><span>Medium</span>{entry.data.medium.join(', ')}</div>}{entry.data.researchAreas.length>0&&<div><span>Research</span>{entry.data.researchAreas.join(', ')}</div>}{entry.data.collaborators.length>0&&<div><span>Collaborators</span>{entry.data.collaborators.join(', ')}</div>}{entry.data.mainLink&&<div><span>Link</span><a href={entry.data.mainLink} target="_blank" rel="noopener noreferrer">visit ↗</a></div>}{entry.data.artistsInvolved.length>0&&<div><span>Artists involved</span>{entry.data.artistsInvolved.join(', ')}</div>}{entry.data.curatedBy.length>0&&<div><span>Curated by</span>{entry.data.curatedBy.join(', ')}</div>}{entry.data.credits.length>0&&<div><span>Credits</span>{entry.data.credits.join(', ')}</div>}{entry.data.photoCredits.length>0&&<div><span>Photo credits</span>{entry.data.photoCredits.join(', ')}</div>}
    </aside>
  </div>
  {entry.data.gallery.length>0&&<section class="media-grid">{entry.data.gallery.map((src,i)=><figure><img src={src} alt={`${entry.data.title} — ${i+1}`} loading="lazy" /></figure>)}</section>}
  {entry.data.videos.length>0&&<section class="video-list">{entry.data.videos.map(src=><video src={src} controls playsinline preload="metadata"></video>)}</section>}
  {entry.data.moments.length>0&&<section class="project-moments"><h2>Outputs</h2>{entry.data.moments.map(moment=>{const relatedWork=worksByTitle.get(moment.title.toLowerCase());const outputType=moment.type||relatedWork?.data.displayType||'';return <div class="project-moment"><span class="output-date">{moment.date}</span><strong class="output-title">{moment.href?<a href={moment.href} target="_blank" rel="noopener noreferrer">{moment.title} ↗</a>:moment.title}</strong>{outputType&&<span class="output-type">{outputType}</span>}{moment.location&&<span class="output-location">{moment.location}</span>}{moment.gallery.length>0?<MomentGallery images={moment.gallery} title={moment.title}/>:moment.media&&<img src={moment.media} alt="" loading="lazy" />}</div>;})}</section>}
  {entry.data.links.length>0&&<section class="project-links"><h2>Links</h2>{entry.data.links.map(link=><a href={link} target="_blank" rel="noreferrer">{link} ↗</a>)}</section>}
  <style>
    .project-entry-loader{position:fixed;inset:0;z-index:10000;background:var(--bg);display:grid;place-items:center;overflow:hidden;opacity:1;visibility:visible;pointer-events:all;transition:opacity .22s linear,visibility 0s linear .22s}.project-entry-loader.is-leaving{opacity:0;visibility:hidden}.project-entry-loader img,.project-entry-loader video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.25);animation:entry-avatar 820ms cubic-bezier(.22,.61,.36,1) both}.project-entry-loader::after{content:'';position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent 0 3px,color-mix(in srgb,var(--signal) 9%,transparent) 3px 4px);pointer-events:none}.project-entry-signal{position:absolute;left:16px;bottom:16px;right:16px;z-index:2;display:flex;justify-content:space-between;gap:20px;font-family:var(--mono);font-size:10px;text-transform:uppercase;color:var(--signal);mix-blend-mode:difference}.project-facts{font-size:11px;line-height:1.28}.project-facts>div{display:grid;grid-template-columns:minmax(72px,.75fr) minmax(0,1.6fr);gap:12px;padding:6px 0;border-top:1px solid var(--line)}.project-facts>div:last-child{border-bottom:1px solid var(--line)}.project-facts span{font-family:var(--mono);font-size:9px;line-height:1.2;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}.project-facts a{text-decoration:underline;text-underline-offset:.16em;text-decoration-color:var(--signal)}@keyframes entry-avatar{0%{transform:scale(1.08);opacity:0;filter:grayscale(1) contrast(1.7)}16%{opacity:1}72%{transform:scale(1);opacity:1;filter:grayscale(.25) contrast(1.2)}100%{transform:scale(1.015);opacity:1;filter:grayscale(0) contrast(1)}}@media(max-width:760px){.project-entry-signal{left:10px;right:10px;bottom:10px;font-size:8px}.project-facts{font-size:10px}.project-facts>div{grid-template-columns:82px minmax(0,1fr);gap:8px}.project-facts span{font-size:8px}}@media(prefers-reduced-motion:reduce){.project-entry-loader img,.project-entry-loader video{animation:none}}
  </style>
  {loaderImage&&<script is:inline>document.addEventListener('DOMContentLoaded',()=>{const loader=document.querySelector('[data-project-loader]');if(!loader)return;document.body.style.overflow='hidden';window.setTimeout(()=>{loader.classList.add('is-leaving');document.body.style.overflow='';},1000);window.setTimeout(()=>loader.remove(),1300);});</script>}
</BaseLayout>
