{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "teaser": {
      "type": "string"
    },
    "mainLink": {
      "type": "string"
    },
    "year": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "displayType": {
      "type": "string"
    },
    "startDate": {
      "type": "string"
    },
    "endDate": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ongoing",
        "completed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "medium": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "themes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "researchAreas": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "urban-wilderness",
          "generative-archives",
          "interspecies",
          "technology-digitalization",
          "emotional-geographies",
          "eco-feminism",
          "pleasure-activism"
        ]
      }
    },
    "collaborators": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artistsInvolved": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "curatedBy": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "credits": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "photoCredits": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avatar": {
      "type": "string"
    },
    "cover": {
      "type": "string"
    },
    "gallery": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "videos": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moments": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "media": {
            "type": "string"
          },
          "gallery": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "href": {
            "type": "string"
          },
          "curatedBy": {
            "type": "string"
          },
          "artistsInvolved": {
            "type": "string"
          },
          "credits": {
            "type": "string"
          },
          "photoCredits": {
            "type": "string"
          },
          "collaborators": {
            "type": "string"
          }
        },
        "required": [
          "date",
          "title"
        ]
      }
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "portfolio": {
      "default": {
        "art": false,
        "research": false,
        "digital": false
      },
      "type": "object",
      "properties": {
        "art": {
          "default": false,
          "type": "boolean"
        },
        "research": {
          "default": false,
          "type": "boolean"
        },
        "digital": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "type": {
      "type": "string",
      "const": "work"
    },
    "parent": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "project",
            "exhibition"
          ]
        },
        "slug": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "slug"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "type"
  ]
}