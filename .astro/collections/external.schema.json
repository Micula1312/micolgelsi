{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "teaser": {
      "type": "string"
    },
    "mainLink": {
      "type": "string"
    },
    "kind": {
      "default": "external project",
      "type": "string"
    },
    "year": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "startDate": {
      "type": "string"
    },
    "endDate": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ongoing",
        "completed"
      ]
    },
    "url": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "themes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "researchAreas": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "urban-wilderness",
          "generative-archives",
          "interspecies",
          "technology-digitalization",
          "emotional-geographies",
          "eco-feminism",
          "pleasure-activism"
        ]
      }
    },
    "collaborators": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artistsInvolved": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "curatedBy": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "credits": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "photoCredits": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avatar": {
      "type": "string"
    },
    "moments": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "media": {
            "type": "string"
          },
          "gallery": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "href": {
            "type": "string"
          },
          "curatedBy": {
            "type": "string"
          },
          "artistsInvolved": {
            "type": "string"
          },
          "credits": {
            "type": "string"
          },
          "photoCredits": {
            "type": "string"
          },
          "collaborators": {
            "type": "string"
          }
        },
        "required": [
          "date",
          "title"
        ]
      }
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}